-.mg-front-title-block { max-width: 46rem; margin-bottom: var(--s5); }
+/* The title page uses the chapters' frame: the reading column, and the margin column with the book at a glance. */
+.mg-front-frame { display: grid; grid-template-columns: minmax(0, var(--mg-measure)) var(--mg-gap) var(--mg-aside); align-items: start;
+                  max-width: var(--mg-frame); margin: 0 auto; }
+.mg-front-main { grid-column: 1; min-width: 0; }
+.mg-front-rail { grid-column: 3; grid-row: 1; padding-top: calc(var(--s6) + .5rem); font-size: var(--text-sm); line-height: var(--lh-compact); color: var(--ink-2); }
+.mg-rail-block + .mg-routes { margin-top: var(--s3); padding-top: var(--s2); border-top: 1px solid var(--rule-soft); }
+.mg-rail-h { margin: 0 0 .5rem; color: var(--ink-3); font-variant-caps: all-small-caps; letter-spacing: .07em; }
+.mg-glance { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
