+                   '<rect x="6.1" y="6.1" width="3.8" height="3.8" fill="currentColor"/>',
+    'scoped_negative': '<path fill="currentColor" fill-rule="evenodd" d="M2.6 2.6h10.8v10.8H2.6zM4.8 7.1h6.4v1.8H4.8z"/>',
+    'remaining': '<rect x="3.3" y="3.3" width="9.4" height="9.4" fill="none" stroke="currentColor" stroke-width="1.6"/>',
+}
