+def labels_for(page_labels):
+    labels = dict(LABELS)
+    page_labels = page_labels or {}
+    for k, v in page_labels.items():
+        if k.startswith('atlas_') and isinstance(v, str) and k[6:] in LABELS:
+            labels[k[6:]] = v
+    for page_key, key in (('atlas', 'heading'), ('atlas_kicker', 'kicker'), ('nav_atlas', 'nav')):
+        if isinstance(page_labels.get(page_key), str) and page_labels[page_key].strip():
+            labels[key] = page_labels[page_key]
+    return labels
+
+
+def stylesheet():
+    return (HERE / 'atlas.css').read_text(encoding='utf-8')
+
+
+def script():
+    return (HERE / 'atlas.js').read_text(encoding='utf-8')
+
+
+def render(data, ctx):
+    """The atlas for the page's mount: see the module docstring for the result."""
+    labels = labels_for(getattr(ctx, 'labels', None))
+    atlas = validate(data, ctx)
+    check = Atlas(None)  # the interface words, page.json overrides included, meet the same rules as the data
+    for key, value in sorted(labels.items()):
+        check.safe(f'label {key}', value)
+    problems = atlas.errors + check.errors
+    if atlas.structural or check.errors:
+        return {'html': '', 'problems': problems}
+    renderer = Renderer(ctx, atlas, labels)
+    body = renderer.html()
+    twice = sorted(i for i, n in renderer.uses.items() if n > 1)
+    taken = set(renderer.uses) & set(getattr(ctx, 'anchors', ()))
+    if twice or taken:
+        return {'html': '', 'problems': [f'atlas id used twice: {i}' for i in twice] +
+                [f'atlas id already used on the page: {i}' for i in sorted(taken)]}
+    return {'html': body, 'title': labels['heading'], 'kicker': labels['kicker'], 'nav_label': labels['nav'],
+            'css': stylesheet(), 'js': script(), 'problems': problems + renderer.problems}
+
+
+def cls(code):
+    return code.replace('_', '-')
+
+
+def mark(code, label=None):
+    title = f'<title>{html.escape(label)}</title>' if label else ''
+    attrs = f' role="img" aria-label="{html.escape(label)}"' if label else ' aria-hidden="true"'
+    return (f'<svg class="atlas-mark am am-{cls(code)}" viewBox="0 0 16 16" width="16" height="16"{attrs} '
+            f'focusable="false">{title}{MARKS[code]}</svg>')
+
+
+# Validation -------------------------------------------------------------------------------------
+
+def validate(data, ctx=None):
+    """Check atlas.json. With a context, each statementRef must name a statement anchored on the page."""
+    atlas = Atlas(ctx)
+    atlas.check(data)
+    return atlas
+
+
+def joined(a, b, edges):
+    return [e for e in edges if (e['source'] == a and e['target'] == b) or (e['source'] == b and e['target'] == a)]
+
+
+class Atlas:
+    """The checked contents of atlas.json, with the relations indexed by claim."""
+
+    def __init__(self, ctx):
+        self.ctx = ctx
+        self.errors = []
+        self.structural = []
+        self.domains, self.claims, self.edges, self.comparisons, self.paths = [], [], [], [], []
+        self.claim = {}
+        self.domain = {}
+        self.number = {}
+        self.into = {}
+        self.out = {}
+        self.relations = {}      # relation code -> (label, line style, order of first use)
+        self.status_labels = {}  # status code -> supplied label
+        self.joins = {}          # (path id, stage index) -> [(edge, backward)]
+
+    def err(self, text, reader=False):
+        """Every error fails the build. A structural error (shape, type, reference) also stops rendering; a finding
+        of the reader rules in a text does not, so that a draft build (--allow-draft) still shows the atlas."""
+        self.errors.append(text)
+        if not reader:
+            self.structural.append(text)
+
+    def keys(self, obj, kind, where):
+        if not isinstance(obj, dict):
+            self.err(f'{where}: an object is required')
+            return False
+        required, optional = SHAPE[kind]
+        for k in sorted(required - set(obj)):
+            self.err(f'{where}: missing key {k!r}')
+        for k in sorted(set(obj) - required - optional):
+            # A field the atlas does not show fails the build, so that no field of a new payload is dropped
+            # silently; the atlas still draws in a draft, from the fields it knows (it reads no other).
+            self.err(f'{where}: unknown key {k!r}; the atlas does not show it', reader=True)
+        return True
+
+    def text(self, obj, key, where, empty=False):
+        value = obj.get(key)
+        if not isinstance(value, str):
+            if key in obj:
+                self.err(f'{where}.{key}: a string is required')
+            return ''
+        if not empty and not value.strip():
+            self.err(f'{where}.{key}: empty text')
+        self.safe(f'{where}.{key}', value)
+        return value
+
+    def ref(self, obj, key, where, known, kind):
+        value = obj.get(key)
+        if not isinstance(value, str) or value not in known:
+            self.err(f'{where}.{key}: no {kind} with id {value!r}')
+            return None
+        return value
+
+    def ident(self, obj, where, seen):
+        value = obj.get('id')
+        if not isinstance(value, str) or not ID_RE.match(value) or len(value) > 64:
+            self.err(f'{where}.id: {value!r} is not a lower-case id of letters, digits, - and _ (at most 64)')
+            return None
+        if value in seen:
+            self.err(f'{where}.id: duplicate id {value!r}')
+            return None
+        seen.add(value)
+        self.safe(f'{where}.id', value)
+        return value
+
+    def questions(self, obj, key, where, many):
+        """Ids of questions of the page; each must name a question anchored on the page (#q-...)."""
+        if key not in obj:
+            return []
+        value = obj.get(key)
+        values = value if many else [value]
+        if (many and not isinstance(value, list)) or not all(isinstance(x, str) and x for x in values):
+            self.err(f'{where}.{key}: {"a list of question ids" if many else "a question id"} is required')
+            return []
+        out = []
+        for x in values:
+            anchor = 'q-' + self.ctx.ident(x) if self.ctx is not None else None
+            if anchor is None or anchor not in getattr(self.ctx, 'anchors', ()):
+                # A reference the page cannot resolve fails the build but is not drawn; the atlas still draws for a draft.
+                self.err(f'{where}.{key}: no question on the page with id {x!r}', reader=True)
+            else:
+                out.append(anchor)
+        return out
+
+    def texts(self, obj, key, where):
+        value = obj.get(key, [])
+        if not isinstance(value, list) or not all(isinstance(x, str) and x.strip() for x in value):
+            self.err(f'{where}.{key}: a list of non-empty strings is required')
+            return []
+        for j, x in enumerate(value):
+            self.safe(f'{where}.{key}[{j}]', x)
+        return value
+
+    def ids(self, obj, key, where, known, kind):
+        value = obj.get(key, [])
+        if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
+            self.err(f'{where}.{key}: a list of ids is required')
+            return []
+        out = []
+        for x in value:
+            if x not in known:
+                self.err(f'{where}.{key}: no {kind} with id {x!r}')
+            elif x in out:
+                self.err(f'{where}.{key}: {x!r} is listed twice')
+            else:
+                out.append(x)
+        return out
+
+    def safe(self, where, value):
+        """The page's reader-visible rules, and the atlas's own, applied to every string and id.
+
+        The text is read as written and again with _ and - read as spaces, because the page's rules
+        use word boundaries and _ is a word character."""
+        import audit  # the page's rules; the builder has imported it before the atlas is rendered
+        bare = MATH_RE.sub(' ', value)
+        spaced = re.sub(r'[_-]', ' ', bare)
+        found = set()
+        for pattern, why, flags in audit.FORBIDDEN:
+            for text in (bare, spaced):
+                m = re.search(pattern, text, flags)
+                if m and (why, m.group(0)) not in found:
+                    found.add((why, m.group(0)))
+                    self.err(f'{where}: {why} {m.group(0)!r}', reader=not where.endswith('.id'))
+        for rule, why in ((HOST_RE, 'address of another host'), (HASH_RE, 'hash-like token'),
+                          (PERCENT_RE, 'percentage'), (LABEL_RE, 'label of the form name:part')):
+            m = rule.search(bare)
+            if m:
+                self.err(f'{where}: {why} {m.group(0)!r}', reader=not where.endswith('.id'))
+
+    def check(self, data):
+        if not self.keys(data, 'atlas', 'atlas'):
+            return
+        if data.get('schema') != SCHEMA:
+            self.err(f'atlas.schema: {data.get("schema")!r} is not {SCHEMA!r}')
+        if 'asOf' in data and not isinstance(data['asOf'], str):
+            self.err('atlas.asOf: a string is required')
+        lists = {}
+        for key in ('domains', 'claims', 'edges', 'comparisons', 'readingPaths'):
+            value = data.get(key, [])
+            if not isinstance(value, list):
+                self.err(f'atlas.{key}: a list is required')
+                value = []
+            lists[key] = value
+        if not lists['domains']:
+            self.err('atlas.domains: at least one domain is required')
+        if not lists['claims']:
+            self.err('atlas.claims: at least one claim is required')
+        self.check_domains(lists['domains'])
+        self.check_claims(lists['claims'])
+        self.check_edges(lists['edges'])
+        self.styles()
+        self.check_comparisons(lists['comparisons'])
+        self.check_membership()
+        self.check_paths(lists['readingPaths'])
+
+    def check_domains(self, domains):
+        seen = set()
+        for i, d in enumerate(domains):
+            where = f'domains[{i}]'
+            if not self.keys(d, 'domain', where):
+                continue
+            did = self.ident(d, where, seen)
+            label = self.text(d, 'label', where)
+            summary = self.text(d, 'summary', where)
+            conventions = self.texts(d, 'conventions', where) if 'conventions' in d else []
+            questions = self.questions(d, 'relatedQuestionIds', where, True)
+            if did:
+                self.domain[did] = {'id': did, 'label': label, 'summary': summary, 'conventions': conventions,
+                                    'questions': questions}
+                self.domains.append(self.domain[did])
+
+    def check_claims(self, claims):
+        seen = set()
+        titles = {}
+        for i, c in enumerate(claims):
+            where = f'claims[{i}]'
+            if not self.keys(c, 'claim', where):
+                continue
+            cid = self.ident(c, where, seen)
+            where = f'claims[{i}] ({cid})' if cid else where
+            domain = self.ref(c, 'domainId', where, self.domain, 'domain')
+            code, label = None, ''
+            st = c.get('status')
+            if 'status' in c and self.keys(st, 'status', where + '.status'):
+                code = st.get('code')
+                if not isinstance(code, str) or code not in CODES:
+                    self.err(f'{where}.status.code: {code!r} is not one of {", ".join(CODES)}')
+                    code = None
+                label = self.text(st, 'label', where + '.status')
+                if code and label and label not in self.status_labels.setdefault(code, []):
+                    self.status_labels[code].append(label)  # display aliases: kept and checked, never shown (the code chooses the word)
+            hyps = c.get('hypotheses')
+            if not isinstance(hyps, list) or not all(isinstance(h, str) and h.strip() for h in hyps):
+                if 'hypotheses' in c:
+                    self.err(f'{where}.hypotheses: a list of non-empty strings is required')
+                hyps = []
+            for j, h in enumerate(hyps):
+                self.safe(f'{where}.hypotheses[{j}]', h)
+            if code == 'conditional' and not hyps and isinstance(c.get('hypotheses'), list):
+                self.err(f'{where}: a conditional claim must list the hypotheses it is conditional on', reader=True)
+            if code == 'scoped_negative' and not hyps and isinstance(c.get('hypotheses'), list):
+                self.err(f'{where}: a scoped negative claim must list the hypotheses of its scope', reader=True)
+            source = self.text(c, 'sourceLabel', where) if 'sourceLabel' in c else None
+            comparisons = c.get('comparisonIds')
+            if comparisons is not None and (not isinstance(comparisons, list)
+                                            or not all(isinstance(x, str) for x in comparisons)):
+                self.err(f'{where}.comparisonIds: a list of ids is required')
+                comparisons = []
+            ref = None
+            if 'statementRef' in c:
+                value = c.get('statementRef')
+                anchor = self.ctx.anchor_for(value) if self.ctx is not None and isinstance(value, str) else None
+                if not anchor:
+                    self.err(f'{where}.statementRef: no statement on the page with id {value!r}')
+                else:
+                    ref = anchor
+            title = self.text(c, 'title', where)
+            key = ' '.join(title.split()).casefold()
+            if key and cid:
+                if key in titles:
+                    self.err(f'{where}.title: claims {titles[key]!r} and {cid!r} have the same title')
+                else:
+                    titles[key] = cid
+            claim = {'id': cid, 'domainId': domain, 'title': title, 'statement': self.text(c, 'statement', where),
+                     'code': code, 'label': label, 'hypotheses': hyps, 'sourceLabel': source,
+                     'comparisonIds': comparisons, 'statementRef': ref}
+            if cid and code and domain:
+                self.claim[cid] = claim
+                self.claims.append(claim)
+                self.number[cid] = len(self.claims)
+                self.into[cid] = []
+                self.out[cid] = []
+
+    def check_edges(self, edges):
+        seen = set()
+        triples = set()
+        for i, e in enumerate(edges):
+            where = f'edges[{i}]'
+            if not self.keys(e, 'edge', where):
+                continue
+            eid = self.ident(e, where, seen)
+            where = f'edges[{i}] ({eid})' if eid else where
+            source = self.ref(e, 'source', where, self.claim, 'claim')
+            target = self.ref(e, 'target', where, self.claim, 'claim')
+            ok = bool(source and target and eid)
+            if source and source == target:
+                self.err(f'{where}: a claim related to itself')
+                ok = False
+            relation = e.get('relation')
+            if not isinstance(relation, str) or not RELATION_RE.match(relation):
+                self.err(f'{where}.relation: {relation!r} is not a relation code (words joined by _, - or spaces)')
+                ok = False
+            else:
+                self.safe(f'{where}.relation', relation)
+            label = self.text(e, 'label', where)
+            scope = self.text(e, 'scope', where, empty=True)
+            if not ok:
+                continue
+            if (source, target, relation) in triples:
+                self.err(f'{where}: a second {relation!r} edge from {source!r} to {target!r}')
+                continue
+            triples.add((source, target, relation))
+            if relation in self.relations:
+                if label not in self.relations[relation][0]:
+                    self.relations[relation][0].append(label)  # each edge's own label is shown with the edge
+            else:
+                n = len(self.relations)
+                self.relations[relation] = ([label], n, n)
+            edge = {'id': eid, 'source': source, 'target': target, 'relation': relation, 'label': label, 'scope': scope}
+            self.edges.append(edge)
+            self.out[source].append(edge)
+            self.into[target].append(edge)
+
+    def styles(self):
+        """Line style of each relation: its own when there are at most LINE_STYLES types, else the plain line for all."""
+        plain = len(self.relations) > LINE_STYLES
+        for rel, (labels, n, order) in list(self.relations.items()):
+            self.relations[rel] = (labels, LINE_STYLES if plain else n, order)
+
+    def check_comparisons(self, comparisons):
+        seen = set()
+        for i, k in enumerate(comparisons):
+            where = f'comparisons[{i}]'
+            if not self.keys(k, 'comparison', where):
+                continue
+            kid = self.ident(k, where, seen)
+            where = f'comparisons[{i}] ({kid})' if kid else where
+            domain = self.ref(k, 'domainId', where, self.domain, 'domain')
+            item = {'id': kid, 'domainId': domain, 'title': self.text(k, 'title', where),
+                    'overview': self.text(k, 'overview', where), 'buckets': [],
+                    'question': self.questions(k, 'questionId', where, False),
+                    'questions': self.questions(k, 'relatedQuestionIds', where, True)}
+            listed = {}
+            for key, code in BUCKETS:
+                members = self.ids(k, key, where, self.claim, 'claim')
+                kept = []
+                for cid in members:
+                    if cid in listed:
+                        self.err(f'{where}: claim {cid!r} is in both {listed[cid]} and {key}')
+                        continue
+                    listed[cid] = key
+                    kept.append(cid)
+                    if self.claim[cid]['code'] != code:
+                        self.err(f'{where}.{key}: claim {cid!r} has status {self.claim[cid]["code"]!r}, not {code!r}')
+                item['buckets'].append((code, kept))
+            if not listed:
+                self.err(f'{where}: the comparison lists no claim')
+            if kid and domain:
+                self.comparisons.append(item)
+
+    def check_membership(self):
+        listed = {}
+        for k in self.comparisons:
+            for _, members in k['buckets']:
+                for cid in members:
+                    listed.setdefault(cid, set()).add(k['id'])
+        known = {k['id'] for k in self.comparisons}
+        for c in self.claims:
+            mine = listed.get(c['id'], set())
+            if c['comparisonIds'] is not None:
+                own = set(c['comparisonIds'])
+                for kid in sorted(own - known):
+                    self.err(f'claims ({c["id"]}).comparisonIds: no comparison with id {kid!r}')
+                for kid in sorted((own & known) ^ mine):
+                    self.err(f'claim {c["id"]!r} and comparison {kid!r} disagree on whether the claim is in it')
+            c['comparisonIds'] = [k['id'] for k in self.comparisons if k['id'] in mine]
+
+    def check_paths(self, paths):
+        seen = set()
+        for i, p in enumerate(paths):
+            where = f'readingPaths[{i}]'
+            if not self.keys(p, 'path', where):
+                continue
+            pid = self.ident(p, where, seen)
+            where = f'readingPaths[{i}] ({pid})' if pid else where
+            kind = p.get('kind')
+            if not isinstance(kind, str) or kind not in PATH_KINDS:
+                self.err(f'{where}.kind: {kind!r} is not one of {", ".join(PATH_KINDS)}')
+                kind = None
+            title = self.text(p, 'title', where)
+            summary = self.text(p, 'summary', where)
+            note = self.text(p, 'note', where) if 'note' in p else ''
+            stages = p.get('stages')
+            if not isinstance(stages, list) or not stages:
+                self.err(f'{where}.stages: at least one stage is required')
+                stages = []
+            items = []
+            for j, s in enumerate(stages):
+                sw = f'{where}.stages[{j}]'
+                if not self.keys(s, 'stage', sw):
+                    continue
+                items.append({'label': self.text(s, 'label', sw), 'description': self.text(s, 'description', sw, empty=True),
+                              'claimIds': self.ids(s, 'claimIds', sw, self.claim, 'claim')})
+            if kind == 'source_bound_dependency_path' and pid:
+                self.check_joins(pid, where, items)
+            if pid and kind:
+                self.paths.append({'id': pid, 'title': title, 'kind': kind, 'summary': summary, 'note': note, 'stages': items})
+
+    def check_joins(self, pid, where, items):
+        """Every claim of a stage is joined by a recorded relation to a claim of the stage next to it:
+        the first stage to the second, every later stage to the one before it."""
+        if len(items) < 2:
+            self.err(f'{where}: a path joined by recorded relations needs at least two stages')
+        for j, s in enumerate(items):
+            if not s['claimIds']:
+                self.err(f'{where}.stages[{j}]: a stage of a path joined by recorded relations needs a claim')
+        for j, s in enumerate(items):
+            other = j + 1 if j == 0 else j - 1
+            if other >= len(items):
+                continue
+            for cid in s['claimIds']:
+                if not any(joined(cid, o, self.edges) for o in items[other]['claimIds']):
+                    self.err(f'{where}.stages[{j}]: claim {cid!r} is joined to no claim of stage {other + 1} '
+                             f'by a recorded relation')
+        for j in range(1, len(items)):
+            before, here = set(items[j - 1]['claimIds']), set(items[j]['claimIds'])
+            self.joins[(pid, j)] = [(e, e['source'] in here) for e in self.edges
+                                    if (e['source'] in before and e['target'] in here)
+                                    or (e['source'] in here and e['target'] in before)]
+
+
+# Rendering --------------------------------------------------------------------------------------
+
+class Renderer:
+    """The atlas markup. Hooks: a claim is article[data-claim-id][data-status-code] with the anchor
+    atlas-c-<id>; a relation is [data-edge-id][data-source][data-target][data-relation] wherever it is
+    listed or drawn; a reading path is article[data-path-id][data-path-kind]."""
+
+    def __init__(self, ctx, atlas, labels):
+        self.ctx = ctx
+        self.a = atlas
+        self.L = labels
+        self.uses = {}  # anchor -> times used; two uses is a problem
+        self.problems = []  # reader findings of the renderer (the build fails; a draft still draws)
+
+    def esc(self, key, **kw):
+        text = self.L[key]
+        return html.escape(text.format(**kw) if kw else text)
+
+    def rich(self, text, terms=True):
+        markup = self.ctx.rich(text, terms=terms and TERMS)
+        for old, new in FORMULA_CLASSES:
+            markup = markup.replace(old, new)
+        return markup
+
+    def paragraphs(self, text):
+        blocks = [b.strip() for b in re.split(r'\n\s*\n', text or '') if b.strip()]
+        return ''.join(f'<p>{self.rich(b)}</p>' for b in blocks)
+
+    def anchor(self, aid):
+        self.uses[aid] = self.uses.get(aid, 0) + 1
+        return aid
+
+    def html(self):
+        a, L = self.a, self.L
+        parts = [('atlas-overview', L['part_map'], True), ('atlas-domains', L['part_domains'], True),
+                 ('atlas-claims', L['part_claims'], True),
+                 ('atlas-comparisons', L['part_comparisons'], bool(a.comparisons)),
+                 ('atlas-paths', L['part_paths'], bool(a.paths))]
+        nav = ''.join(f'<li><a href="#{pid}">{html.escape(t)}</a></li>' for pid, t, on in parts if on)
+        words = ' '.join(f'<span data-word="{k[3:].replace("_", "-")}">{html.escape(v)}</span>'
+                         for k, v in sorted(L.items()) if k.startswith('js_'))
+        main = f'{self.overview()}{self.domains()}{self.claims()}{self.comparisons()}{self.paths()}'
+        return (f'<p class="section-intro prose atlas-intro">{html.escape(L["intro"])}</p>'
+                f'<nav class="atlas-parts" aria-label="{self.esc("parts")}"><ul>{nav}</ul></nav>'
+                f'<div class="atlas-body"><template class="atlas-wordlist">{words}</template>'
+                f'<div class="atlas-main">{main}</div>{self.claim_list()}</div>')
+
+    # Pieces ---------------------------------------------------------------------------------------
+
+    def title(self, c):
+        return self.rich(c['title'], terms=False)
+
+    def num(self, cid):
+        """The index number of a claim; read aloud and in plain text as 'No. 5', so never as a count."""
+        return f'<span class="atlas-num"><span class="atlas-vh">{self.esc("number")} </span>{self.a.number[cid]}</span>'
+
+    def link(self, cid, labelled=False):
+        """A claim named anywhere in the atlas: its index number, its mark and its title, as one link."""
+        c = self.a.claim[cid]
+        # Where the list is not grouped by status, the mark is named by its group, the word the key gives the mark
+        # (the claim's own label is shown with the claim); in a grouped list the group heading names it.
+        label = self.L['group_' + c['code']] if labelled else None
+        return (f'<a class="atlas-link" href="#atlas-c-{cid}">{self.num(cid)}'
+                f'{mark(c["code"], label)}<span class="atlas-link-title">{self.title(c)}</span></a>')
+
+    def item(self, cid):
+        """A claim in a grouped list; a conditional claim and a scoped negative keep their hypotheses."""
+        c = self.a.claim[cid]
+        hyps = ''
+        if c['code'] in ('conditional', 'scoped_negative') and c['hypotheses']:
+            lis = ''.join(f'<li>{self.rich(h)}</li>' for h in c['hypotheses'])
+            hyps = (f'<div class="atlas-item-hyps"><span class="atlas-note-label">{self.esc("hypotheses_inline")}</span>'
+                    f'<ol>{lis}</ol></div>')
+        return f'<li>{self.link(cid)}{hyps}</li>'
+
+    def group(self, code, members, kind='group'):
+        shown = ''.join(self.item(cid) for cid in members[:GROUP_SHOWN])
+        rest = ''.join(self.item(cid) for cid in members[GROUP_SHOWN:])
+        body = (f'<ul class="atlas-claimlist">{shown}</ul>' if shown
+                else f'<p class="atlas-none">{self.esc("none_listed")}</p>')
+        if rest:
+            body += (f'<details class="atlas-more"><summary class="atlas-more-h">{self.esc("more")}</summary>'
+                     f'<ul class="atlas-claimlist">{rest}</ul></details>')
+        prefix = 'ag' if kind == 'group' else 'ab'
+        return (f'<div class="atlas-{kind} {prefix}-{cls(code)}"><h5 class="atlas-group-h">{mark(code)}'
+                f'<span>{self.esc("group_" + code)}</span></h5>{body}</div>')
+
+    def part(self, pid, title, body, extra_cls='', lead=None):
+        self.anchor(pid)
+        self.anchor(f'{pid}-h')
+        lead = f'<p class="atlas-part-lead">{self.esc(lead)}</p>' if lead else ''
+        return (f'<section class="atlas-part{extra_cls}" id="{pid}" aria-labelledby="{pid}-h">'
+                f'<header class="atlas-part-head"><h3 class="atlas-part-h" id="{pid}-h"><a class="anchor" href="#{pid}">'
+                f'{html.escape(title)}</a></h3>{lead}</header>{body}</section>')
+
+    def overview(self):
+        """The first part: the map of every claim and relation, with the key as its legend."""
+        return self.part('atlas-overview', self.L['part_map'], self.key() + self.map(), extra_cls=' atlas-overview',
+                         lead='lead_map')
+
+    def key(self):
+        items = []
+        for code in CODES:
+            own = self.page_status(code)
+            items.append(f'<div class="atlas-key-item" data-key-status="{code}"><dt>{mark(code)}<span>{self.esc("group_" + code)}'
+                         f'</span></dt><dd>{self.esc("gloss_" + code)}{own}</dd></div>')
+        if self.a.relations and any(k == LINE_STYLES for _, k, _ in self.a.relations.values()):
+            # Too many types for distinct line styles: one plain line; each relation is named where it is listed.
+            names = sorted(self.a.relations.items(), key=lambda kv: ' / '.join(kv[1][0]).lower())
+            items_ = ''.join(f'<li data-key-relation="{html.escape(rel)}" data-key-style="{LINE_STYLES}">'
+                             f'{html.escape(" / ".join(labels))}</li>' for rel, (labels, _, _) in names)
+            rels = (f'<p class="atlas-rel-plain">{swatch(LINE_STYLES)}<span>{self.esc("key_plain_all")}</span></p>'
+                    f'<details class="atlas-more atlas-rel-all"><summary class="atlas-more-h">{self.esc("rel_list")}</summary>'
+                    f'<ul class="atlas-rel-names">{items_}</ul></details>')
+        elif self.a.relations:
+            rels = ''.join(f'<li data-key-relation="{html.escape(rel)}" data-key-style="{k}">{swatch(k)}'
+                           f'<span class="atlas-rel-name">{html.escape(" / ".join(labels))}</span></li>'
+                           for rel, (labels, k, _) in self.a.relations.items())
+            rels = f'<ul class="atlas-rel-key">{rels}</ul>'
+        else:
+            rels = f'<p class="atlas-none">{self.esc("key_relations_none")}</p>'
+        self.anchor('atlas-key-h')
+        return (f'<div class="atlas-key" role="group" aria-labelledby="atlas-key-h">'
+                f'<p class="atlas-key-h" id="atlas-key-h">{self.esc("key")}</p>'
+                f'<div class="atlas-key-cols"><div><p class="atlas-key-sub">{self.esc("key_status")}</p>'
+                f'<dl class="atlas-key-status">{"".join(items)}</dl>'
+                f'<p class="atlas-key-note">{self.esc("key_separate")}</p></div>'
+                f'<div class="atlas-key-relations"><p class="atlas-key-sub">{self.esc("key_relations")}</p>{rels}</div>'
+                f'</div></div>')
+
+    def unit_status(self, code):
+        """For the page search: every claim is offered with the page status of its atlas status (data-qh-unit-status),
+        so the page's status filters find it and its result shows the page's mark and word for that status."""
+        page = PAGE_STATUS.get(code)
+        return f' data-qh-unit-status="{html.escape(page)}"' if page else ''
+
+    def page_status(self, code):
+        """The page's mark for the page status of an atlas status (PAGE_STATUS), read from the page (ctx.mark). The word
+        is the same on both sides and is chosen by the stored code."""
+        page = PAGE_STATUS.get(code)
+        if not page:
+            return ''
+        drawn = self.ctx.mark(page) if hasattr(self.ctx, 'mark') else ''
+        if not drawn:
+            # The alias is the content owner's ruling: a page that cannot show it fails the build, never silently.
+            if any(c['code'] == code for c in self.a.claims):
+                self.problems.append(f'the page has no mark for its status {page!r}, the page status of the atlas status {code!r}')
+            return ''
+        return f' <span class="atlas-key-page"><span class="atlas-note-label">{self.esc("key_page")}</span> {drawn}</span>'
+
+    def domains(self):
+        a = self.a
+        cards = []
+        for d in a.domains:
+            did = self.anchor(f'atlas-d-{d["id"]}')
+            self.anchor(f'{did}--h')
+            members = [c for c in a.claims if c['domainId'] == d['id']]
+            groups = ''.join(self.group(code, [c['id'] for c in members if c['code'] == code]) for code in CODES)
+            own = [k for k in a.comparisons if k['domainId'] == d['id']]
+            comps = self.question_links(d['questions'], 'questions_related')
+            conv = ''
+            if d['conventions']:
+                items = ''.join(f'<li>{self.rich(x)}</li>' for x in d['conventions'])
+                conv = (f'<div class="atlas-conventions" id="{self.anchor(did + "--conv")}">'
+                        f'<p class="atlas-sub-h">{self.esc("conventions")}</p><ul>{items}</ul></div>')
+            if own:
+                links = ', '.join(f'<a href="#atlas-k-{k["id"]}">{self.rich(k["title"], terms=False)}</a>' for k in own)
+                comps += (f'<p class="atlas-domain-comps"><span class="atlas-note-label">{self.esc("domain_comparisons")}</span> '
+                          f'{links}</p>')
+            cards.append(f'<article class="atlas-domain" id="{did}" data-domain-id="{d["id"]}" data-qh-unit aria-labelledby="{did}--h">'
+                         f'<h4 class="atlas-domain-h" id="{did}--h" data-qh-unit-title><a class="anchor" href="#{did}">'
+                         f'{self.rich(d["label"], terms=False)}</a></h4>'
+                         f'<div class="atlas-domain-summary prose">{self.paragraphs(d["summary"])}</div>'
+                         f'{conv}<div class="atlas-groups">{groups}</div>{comps}</article>')
+        return self.part('atlas-domains', self.L['part_domains'], f'<div class="atlas-domains">{"".join(cards)}</div>',
+                         lead='lead_domains')
+
+    def claims(self):
+        return self.part('atlas-claims', self.L['part_claims'], self.index(), lead='lead_claims')
+
+    def map(self):
+        """Every claim by domain, joined by the recorded edges, at its own size (it scrolls in its box rather than
+        shrinking). A domain with many claims runs over several columns of its lane; the number of rows is the
+        smallest that keeps the whole map within a full column. Each mark is a link to its claim; the drawing is
+        hidden from assistive technology, which reads the index instead."""
+        a = self.a
+        lanes = a.domains
+        col_w, row_h, top, half, min_lane, budget = 58, 26, 18, 22, 96, 1100
+        per = {d['id']: [c for c in a.claims if c['domainId'] == d['id']] for d in lanes}
+        counts = [len(per[d['id']]) for d in lanes]
+        tallest = max(counts + [1])
+
+        def widths(rows):
+            return [max(-(-max(n, 1) // rows) * col_w, min_lane) for n in counts]
+
+        rows = tallest
+        for r in range(min(12, tallest), tallest + 1):
+            if sum(widths(r)) <= budget:
+                rows = r
+                break
+        lane_ws = widths(rows)
+        width = sum(lane_ws)
+        height = top * 2 + (rows - 1) * row_h + 18
+        pos = {}
+        x0 = 0
+        for d, w in zip(lanes, lane_ws):
+            members = per[d['id']]
+            cols = max(1, -(-len(members) // rows))
+            start = x0 + (w - cols * col_w) / 2
+            for k, c in enumerate(members):
+                pos[c['id']] = (start + (k // rows) * col_w + col_w / 2, top + 9 + (k % rows) * row_h)
+            x0 += w
+        edges = []
+        for e in a.edges:
+            (sx, sy), (tx, ty) = pos[e['source']], pos[e['target']]
+            if abs(sx - tx) > .01:
+                way = 1 if tx > sx else -1
+                x_0, x_1 = sx + way * half, tx - way * half
+                bend = (x_1 - x_0) / 2
+                d_ = f'M{x_0:.1f} {sy:.1f}C{x_0 + bend:.1f} {sy:.1f} {x_1 - bend:.1f} {ty:.1f} {x_1:.1f} {ty:.1f}'
+            else:
+                x_0 = sx + half
+                bulge = min(10 + abs(ty - sy) * .2, col_w - 2 * half + 10)
+                d_ = f'M{x_0:.1f} {sy:.1f}C{x_0 + bulge:.1f} {sy:.1f} {x_0 + bulge:.1f} {ty:.1f} {x_0:.1f} {ty:.1f}'
+            k = a.relations[e['relation']][1]
+            edges.append(f'<path class="atlas-edge rk-{k}" d="{d_}" {edge_hooks(e)} marker-end="url(#atlas-arrow)"/>')
+        nodes = []
+        for c in a.claims:
+            x, y = pos[c['id']]
+            nodes.append(f'<a class="atlas-node an-{cls(c["code"])}" href="#atlas-c-{c["id"]}" tabindex="-1" '
+                         f'data-claim-ref="{c["id"]}" transform="translate({x:.1f} {y:.1f})">'
+                         f'<rect x="-{half}" y="-9" width="{2 * half}" height="18" rx="9"/>'
+                         f'<g class="am-{cls(c["code"])}" transform="translate(-19 -6) scale(.75)">{MARKS[c["code"]]}</g>'
+                         f'<text x="7" y="4.5">{a.number[c["id"]]}</text></a>')
+        grid = ' '.join(f'{w}fr' for w in lane_ws)
+        heads = ''.join(f'<a class="atlas-track" href="#atlas-d-{d["id"]}">{self.rich(d["label"], terms=False)}</a>' for d in lanes)
+        feet = ''.join(f'<span class="atlas-track">{self.rich(d["label"], terms=False)}</span>' for d in lanes)
+        defs = ('<defs>' + ''.join(
+            f'<marker id="{mid}" class="{mid}" viewBox="0 0 8 8" refX="7.5" refY="4" markerWidth="7" markerHeight="7" '
+            f'markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0.6 7.6 4 0 7.4z"/></marker>'
+            for mid in ('atlas-arrow', 'atlas-arrow-on')) + '</defs>')
+        edges_x = [sum(lane_ws[:i]) for i in range(1, len(lane_ws))]
+        rules = ''.join(f'<path d="M{x} 0V{height}"/>' for x in edges_x)
+        bands = ''.join(f'<rect x="{sum(lane_ws[:i])}" y="0" width="{lane_ws[i]}" height="{height}"/>' for i in range(1, len(lanes), 2))
+        for aid in ('atlas-map', 'atlas-map-h', 'atlas-arrow', 'atlas-arrow-on'):
+            self.anchor(aid)
+        return (f'<figure class="atlas-map" id="atlas-map" aria-labelledby="atlas-map-h">'
+                f'<p class="atlas-fig-h" id="atlas-map-h">{self.esc("map")}</p>'
+                f'<div class="atlas-map-scroll" tabindex="0" role="region" aria-label="{self.esc("map_scroll")}">'
+                f'<div class="atlas-map-inner" style="--map-w:{width}">'
+                f'<div class="atlas-tracks" style="grid-template-columns:{grid}">{heads}</div>'
+                f'<svg class="atlas-map-svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}" '
+                f'aria-hidden="true" focusable="false">{defs}<g class="atlas-track-bands">{bands}</g>'
+                f'<g class="atlas-track-rules">{rules}</g>'
+                f'<g class="atlas-edges">{"".join(edges)}</g><g class="atlas-nodes">{"".join(nodes)}</g></svg>'
+                f'<div class="atlas-tracks atlas-tracks-foot" style="grid-template-columns:{grid}" aria-hidden="true">{feet}</div>'
+                f'</div></div>'
+                f'<figcaption class="atlas-caption">{self.esc("map_caption")}</figcaption></figure>')
+
+    def index(self):
+        a = self.a
+        rows = []
+        for c in a.claims:
+            rid = self.anchor(f'atlas-r-{c["id"]}')
+            d = a.domain[c['domainId']]
+            label = self.rich(d['label'], terms=False)
+            rows.append(f'<tr id="{rid}" data-claim-ref="{c["id"]}">'
+                        f'<td class="atlas-col-num">{a.number[c["id"]]}</td>'
+                        f'<th scope="row" class="atlas-col-claim"><a class="atlas-link" href="#atlas-c-{c["id"]}">'
+                        f'<span class="atlas-link-title">{self.title(c)}</span></a>'
+                        f'<span class="atlas-row-domain">{label}</span></th>'
+                        f'<td class="atlas-col-domain"><a href="#atlas-d-{d["id"]}">{label}</a></td>'
+                        f'<td class="atlas-col-status">{mark(c["code"])}<span>{self.esc("group_" + c["code"])}</span></td>'
+                        f'<td class="atlas-col-n">{len(a.into[c["id"]])}</td><td class="atlas-col-n">{len(a.out[c["id"]])}</td></tr>')
+        self.anchor('atlas-index')
+        long = ' atlas-index-long' if len(a.claims) > INDEX_LONG else ''
+        return (f'<div class="atlas-index{long}" id="atlas-index"><div class="atlas-table-wrap">'
+                f'<table class="atlas-table"><caption><span class="atlas-fig-h">{self.esc("index")}</span>'
+                f'<span class="atlas-caption">{self.esc("index_caption")}</span></caption>'
+                f'<thead><tr><th scope="col" class="atlas-col-num">{self.esc("col_number")}</th>'
+                f'<th scope="col" class="atlas-col-claim">{self.esc("col_claim")}</th>'
+                f'<th scope="col" class="atlas-col-domain">{self.esc("col_domain")}</th>'
+                f'<th scope="col" class="atlas-col-status">{self.esc("col_status")}</th>'
+                f'<th scope="col" class="atlas-col-n">{self.esc("col_in")}</th>'
+                f'<th scope="col" class="atlas-col-n">{self.esc("col_out")}</th></tr></thead>'
+                f'<tbody>{"".join(rows)}</tbody></table></div></div>')
+
+    def claim_list(self):
+        """Every claim in full, by domain. Without the script and in print it is the last part of the
+        atlas; with the script it is the pane that shows the claim the address names."""
+        groups = []
+        for d in self.a.domains:
+            members = [c for c in self.a.claims if c['domainId'] == d['id']]
+            if members:
+                groups.append(f'<div class="atlas-claim-group"><h4 class="atlas-claim-group-h">'
+                              f'{self.rich(d["label"], terms=False)}</h4>{"".join(self.claim(c) for c in members)}</div>')
+        return self.part('atlas-full', self.L['part_full'], ''.join(groups), extra_cls=' atlas-claims-full')
+
+    def claim(self, c):
+        a = self.a
+        cid, code = c['id'], c['code']
+        aid = self.anchor(f'atlas-c-{cid}')
+        self.anchor(f'{aid}--h')
+        d = a.domain[c['domainId']]
+        hyps = ''.join(f'<li>{self.rich(h)}</li>' for h in c['hypotheses'])
+        hyps = f'<ol class="atlas-hyps">{hyps}</ol>' if hyps else f'<p class="atlas-none">{self.esc("hypotheses_none")}</p>'
+        notes = []
+        if c['sourceLabel']:
+            notes.append(f'<p class="atlas-note atlas-note-source"><span class="atlas-note-label">{self.esc("source")}</span> '
+                         f'<span class="atlas-note-text">{self.rich(c["sourceLabel"], terms=False)}</span></p>')
+        if c['comparisonIds']:
+            names = {k['id']: k for k in a.comparisons}
+            links = ', '.join(f'<a href="#atlas-k-{kid}">{self.rich(names[kid]["title"], terms=False)}</a>'
+                              for kid in c['comparisonIds'])
+            notes.append(f'<p class="atlas-note"><span class="atlas-note-label">{self.esc("in_comparisons")}</span> '
+                         f'<span class="atlas-note-text">{links}</span></p>')
+        if c['statementRef']:
+            notes.append(f'<p class="atlas-note"><a class="atlas-page-link" href="{html.escape(c["statementRef"])}">'
+                         f'{self.esc("statement_link")}</a></p>')
+        if d['conventions']:
+            notes.append(f'<p class="atlas-note"><a class="atlas-conv-link" href="#atlas-d-{d["id"]}--conv">'
+                         f'{self.esc("conventions_link")}</a></p>')
+        return (f'<article class="atlas-claim as-{cls(code)}" id="{aid}" data-claim-id="{cid}" data-status-code="{code}" '
+                f'data-domain-id="{d["id"]}" data-number="{a.number[cid]}" data-qh-unit{self.unit_status(code)} aria-labelledby="{aid}--h">'
+                f'<header class="atlas-claim-head"><p class="atlas-claim-meta">'
+                f'<span class="atlas-chip ac-{cls(code)}">{mark(code)}<span class="atlas-chip-group">'
+                f'{self.esc("group_" + code)}</span></span>'
+                f'<span class="atlas-claim-no">{self.esc("number")} {a.number[cid]}</span>'
+                f'<span class="atlas-claim-domain"><a href="#atlas-d-{d["id"]}">{self.rich(d["label"], terms=False)}</a></span></p>'
+                f'<h5 class="atlas-claim-title" id="{aid}--h" data-qh-unit-title>{self.title(c)}</h5></header>'
+                f'<div class="atlas-statement">{self.paragraphs(c["statement"])}</div>'
+                f'<div class="atlas-hyp-block"><p class="atlas-sub-h">{self.esc("hypotheses")}</p>{hyps}</div>'
+                f'{"".join(notes)}{self.relations(c, "in")}{self.relations(c, "out")}</article>')
+
+    def question_links(self, anchors, label):
+        """Links to questions of the page. Their text is filled with the question's own heading by the script;
+        without it the links say only that they lead to a question on this page."""
+        if not anchors:
+            return ''
+        links = ', '.join(f'<a class="atlas-question-link" href="#{q}" data-question-ref="{q}">{self.esc("question_link")}</a>'
+                          for q in anchors)
+        return f'<p class="atlas-note"><span class="atlas-note-label">{self.esc(label)}</span> {links}</p>'
+
+    def sentence(self, e, me=None):
+        """One recorded relation as the sentence '<source> <label> <target>', in the edge's own direction.
+        `me` names the claim the list belongs to, which is written as 'this claim'."""
+        k = self.a.relations[e['relation']][1]
+        rel = f'<span class="atlas-rel-label">{swatch(k)}{html.escape(e["label"])}</span>'
+        if me == e['target']:
+            body = f'{self.link(e["source"], labelled=True)} {rel} <span class="atlas-rel-self">{self.esc("this_claim")}</span>'
+        elif me == e['source']:
+            body = f'<span class="atlas-rel-self">{self.esc("this_claim_lead")}</span> {rel} {self.link(e["target"], labelled=True)}'
+        else:
+            body = f'{self.link(e["source"], labelled=True)} {rel} {self.link(e["target"], labelled=True)}'
+        scope = f'<span class="atlas-rel-scope">{self.rich(e["scope"])}</span>' if e['scope'].strip() else ''
+        return f'<span class="atlas-rel-sentence">{body}</span>{scope}'
+
+    def relations(self, c, way):
+        a = self.a
+        edges = a.into[c['id']] if way == 'in' else a.out[c['id']]
+        edges = sorted(edges, key=lambda e: a.relations[e['relation']][2])  # stable: data order within a relation
+        items = ''.join(f'<li class="atlas-rel" {edge_hooks(e)}>{self.sentence(e, c["id"])}</li>' for e in edges)
+        heading = self.esc('rel_in' if way == 'in' else 'rel_out')
+        body = (f'<ul class="atlas-rels" data-dir="{way}">{items}</ul>' if items
+                else f'<p class="atlas-none">{self.esc("rel_none")}</p>')
+        return f'<div class="atlas-rel-block" data-dir="{way}"><p class="atlas-sub-h">{heading}</p>{body}</div>'
+
+    def comparisons(self):
+        a = self.a
+        if not a.comparisons:
+            return ''
+        out = []
+        for k in a.comparisons:
+            kid = self.anchor(f'atlas-k-{k["id"]}')
+            self.anchor(f'{kid}--h')
+            d = a.domain[k['domainId']]
+            buckets = ''.join(self.group(code, members, kind='bucket') for code, members in k['buckets'])
+            out.append(f'<article class="atlas-comparison" id="{kid}" data-comparison-id="{k["id"]}" data-qh-unit aria-labelledby="{kid}--h">'
+                       f'<p class="atlas-claim-domain"><a href="#atlas-d-{d["id"]}">{self.rich(d["label"], terms=False)}</a></p>'
+                       f'<h4 class="atlas-comparison-h" id="{kid}--h" data-qh-unit-title><a class="anchor" href="#{kid}">'
+                       f'{self.rich(k["title"], terms=False)}</a></h4>'
+                       f'<div class="atlas-overview prose">{self.paragraphs(k["overview"])}</div>'
+                       f'{self.question_links(k["question"], "question_own")}{self.question_links(k["questions"], "questions_related")}'
+                       f'<div class="atlas-buckets">{buckets}</div></article>')
+        return self.part('atlas-comparisons', self.L['part_comparisons'], f'<div class="atlas-comparisons">{"".join(out)}</div>',
+                         lead='lead_comparisons')
+
+    def paths(self):
+        a = self.a
+        if not a.paths:
+            return ''
+        out = []
+        for p in a.paths:
+            pid = self.anchor(f'atlas-p-{p["id"]}')
+            self.anchor(f'{pid}--h')
+            dep = p['kind'] == 'source_bound_dependency_path'
+            kind = (f'<p class="atlas-path-kind"><span class="atlas-kind-tag">'
+                    f'{self.esc("path_dependency" if dep else "path_editorial")}</span> '
+                    f'{self.esc("path_dependency_note" if dep else "path_editorial_note")}</p>')
+            stages = []
+            for j, s in enumerate(p['stages']):
+                join = ''
+                if dep and j > 0:
+                    lines = ''.join(f'<li {edge_hooks(e)}>{self.sentence(e)}'
+                                    + (f' <span class="atlas-join-back">({self.esc("join_back", n=j + 1, m=j)})</span>' if back else '')
+                                    + '</li>' for e, back in a.joins.get((p['id'], j), []))
+                    join = (f'<div class="atlas-join"><p class="atlas-sub-h">{self.esc("joined", n=j + 1, m=j)}</p>'
+                            f'<ul class="atlas-join-list">{lines}</ul></div>')
+                claims = ''.join(f'<li>{self.link(cid, labelled=True)}</li>' for cid in s['claimIds'])
+                claims = f'<ul class="atlas-claimlist">{claims}</ul>' if claims else ''
+                desc = (f'<div class="atlas-stage-desc prose">{self.paragraphs(s["description"])}</div>'
+                        if s['description'].strip() else '')
+                stages.append(f'<li class="atlas-stage" data-stage="{j}">'
+                              f'<h5 class="atlas-stage-h"><span class="atlas-stage-n">{self.esc("stage", n=j + 1)}</span> '
+                              f'<span class="atlas-stage-label">{self.rich(s["label"], terms=False)}</span></h5>'
+                              f'{join}{desc}{claims}</li>')
+            out.append(f'<article class="atlas-path {"ap-dependency" if dep else "ap-editorial"}" id="{pid}" '
+                       f'data-path-id="{p["id"]}" data-path-kind="{p["kind"]}" data-qh-unit aria-labelledby="{pid}--h">'
+                       f'<h4 class="atlas-path-h" id="{pid}--h" data-qh-unit-title><a class="anchor" href="#{pid}">'
+                       f'{self.rich(p["title"], terms=False)}</a></h4>'
+                       f'{kind}<div class="atlas-path-summary prose">{self.paragraphs(p["summary"])}</div>'
+                       + (f'<p class="atlas-path-note">{self.rich(p["note"])}</p>' if p['note'].strip() else '') +
+                       f'<ol class="atlas-stages">{"".join(stages)}</ol></article>')
+        return self.part('atlas-paths', self.L['part_paths'], f'<div class="atlas-paths">{"".join(out)}</div>',
+                         lead='lead_paths')
+
+
+def edge_hooks(e):
+    return (f'data-edge-id="{e["id"]}" data-source="{e["source"]}" data-target="{e["target"]}" '
+            f'data-relation="{e["relation"]}"')
+
+
+def swatch(k):
+    return (f'<svg class="atlas-swatch rk-{k}" viewBox="0 0 28 8" width="28" height="8" aria-hidden="true" focusable="false">'
+            f'<path d="M1 4H27"/></svg>')
diff --git a/compiler/quantum-holography-status/atlas.css b/compiler/quantum-holography-status/atlas.css
new file mode 100644
index 0000000..3923422
--- /dev/null
+++ b/compiler/quantum-holography-status/atlas.css
@@ -0,0 +1,432 @@
+/* ---------------------------------------------------------------------------------------------
+   The research atlas, inside the page's atlas mount. Embedded after the page's screen sheet and
+   before its print sheet: it uses the page's tokens, and every selector here is scoped to the atlas
+   and its own class names.
+
+   Order of reading: the map of the whole atlas with its key, then the domains, the index of claims,
+   the comparisons, the reading paths and, last, every claim in full. With the script (.atlas-js) the
+   last part becomes the pane that shows the claim the address names: beside the atlas on a wide
+   screen, in the proportion 1.618 : 1, and as a sheet at the foot of the window on a narrow one.
+   Print always shows the one-column atlas.
+
+   Rhythm: one unit, --au, is one line of the page's text (1.55 times the text on screen, 1.42 in
+   print, as the page sets it). Every vertical space between blocks (margins, gaps, the padding of
+   parts, cards and boxes) is a quarter, a half, one or one and a half of it, so the parts, cards and
+   lists keep one beat; only the inner padding of small controls (chips, pills, fields) is set by the
+   control's own height and touch target.
+   Headings: one size per level, each step down smaller at the page's heading weight (600), so no
+   weight can reverse the order: part (h3) 1.3, item (h4) 1.16, claim and stage (h5) 1.08 times the
+   text; group labels are small capitals.
+   --------------------------------------------------------------------------------------------- */
+:root {
+  --as-checked: var(--st-checked); --as-conditional: var(--st-conditional); --as-remaining: var(--st-open);
+  --as-negative: var(--st-refuted-form); --as-line: var(--ink-3); --as-band: var(--paper-2);
+}
+.atlas {
+  --au: calc(var(--text-base) * 1.55);
+  --au-q: calc(var(--au) * .25); --au-h: calc(var(--au) * .5); --au-1: var(--au); --au-2: calc(var(--au) * 1.5);
+}
+
+/* Status marks: the atlas's own family of squares. The atlas colours are the page's status colours: Scoped negative
+   takes the colour of 'refuted form', the statement status of the page that matches it. */
+.atlas-mark { width: .95em; height: .95em; flex: none; vertical-align: -.12em; }
+.atlas .am-checked { color: var(--as-checked); }
+.atlas .am-conditional { color: var(--as-conditional); }
+.atlas .am-scoped-negative { color: var(--as-negative); }
+.atlas .am-remaining { color: var(--as-remaining); }
+.atlas-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+
+/* Head of the section: the introduction and the parts, in the reading column */
+.atlas > .atlas-parts { max-width: var(--measure); margin: 0 auto var(--au-1); }
+.atlas-parts ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--au-q) 8px; }
+.atlas-parts a { display: inline-block; padding: 3px 12px; border: 1px solid var(--rule); border-radius: 999px; background: var(--paper-3);
+                 color: var(--ink-2); text-decoration: none; font-size: var(--text-sm); }
+.atlas-parts a:hover { border-color: var(--ink-4); color: var(--ink); }
+
+.atlas-body { min-width: 0; }
+.atlas-body > template { display: none !important; }
+.atlas-main { min-width: 0; container-type: inline-size; container-name: atlas-main; }
+
+/* Parts: a heading, the question the part answers, its body. */
+.atlas-part { padding-top: var(--au-2); min-width: 0; }
+.atlas-main > .atlas-part:first-child { padding-top: 0; }
+.atlas-part-head { margin: 0 0 var(--au-h); }
+.atlas-part-h { font-size: calc(var(--text-base) * 1.3); font-weight: 600; line-height: 1.2; margin: 0; }
+.atlas-part-lead { max-width: var(--measure); margin: var(--au-q) 0 0; font-size: var(--text-sm); line-height: 1.45; color: var(--ink-2); }
+.atlas-fig-h { display: block; margin: 0 0 var(--au-q); font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-caption { display: block; margin: var(--au-q) 0 0; font-size: var(--text-xs); color: var(--ink-3); line-height: 1.45; }
+.atlas-none { margin: 0; font-size: var(--text-sm); color: var(--ink-3); font-style: italic; }
+.atlas-note-label, .atlas-sub-h { letter-spacing: .04em; color: var(--ink-3); }
+.atlas-sub-h { margin: 0 0 var(--au-q); font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; }
+
+/* Relation line styles: the same six patterns in the key, the lists, the map and the pane. */
+.atlas-swatch { width: 28px; height: 8px; flex: none; vertical-align: middle; overflow: visible; }
+.atlas-swatch path, .atlas-edge, .atlas-hood-edge { fill: none; stroke: var(--as-line); stroke-width: 1.6; stroke-linecap: butt; }
+.atlas .rk-1 path, .atlas path.rk-1 { stroke-dasharray: 6 3.5; }
+.atlas .rk-2 path, .atlas path.rk-2 { stroke-dasharray: 1.4 2.8; stroke-linecap: round; }
+.atlas .rk-3 path, .atlas path.rk-3 { stroke-dasharray: 9 3 2 3; }
+.atlas .rk-4 path, .atlas path.rk-4 { stroke-dasharray: 14 3.5; stroke-width: 2.4; }
+.atlas .rk-5 path, .atlas path.rk-5 { stroke-dasharray: 2.5 5.5; stroke-width: 2.4; }
+.atlas .rk-6 path, .atlas path.rk-6 { stroke-dasharray: 10 2.5 1.4 2.5 1.4 2.5; }
+.atlas .rk-7 path, .atlas path.rk-7 { stroke-dasharray: 4 4; stroke-width: 2.4; }
+.atlas .rk-8 path, .atlas path.rk-8 { stroke: var(--ink-4); stroke-width: 1.1; }
+
+/* The map: the whole atlas at once. Lanes are domains, banded so that each reads as a column; a long
+   domain runs over several columns of marks. On screen the drawing keeps its own size (13 px numbers, the
+   page's small type) and scrolls in its box when the box is narrower; in print it is fitted to the column. */
+.atlas-map { position: relative; margin: 0 0 var(--au-h); min-width: 0; }
+.atlas-map-scroll { overflow-x: auto; overscroll-behavior-x: contain; border: 1px solid var(--rule-soft); border-radius: var(--radius); background: var(--paper-3); }
+.atlas-map-inner { width: calc(var(--map-w) * 1px); margin: 0 auto; padding: 0 0 2px; }
+.atlas-tracks { display: grid; border-bottom: 1px solid var(--rule-soft); }
+.atlas-tracks-foot { border-bottom: 0; border-top: 1px solid var(--rule-soft); }
+.atlas-track { padding: var(--au-q) 6px; text-align: center; font-size: var(--text-xs); letter-spacing: .02em; line-height: 1.25; color: var(--ink-2);
+              text-decoration: none; overflow-wrap: break-word; hyphens: auto; -webkit-hyphens: auto; }
+.atlas-track:nth-child(even) { background: var(--as-band); }
+.atlas-track:hover { color: var(--accent); text-decoration: underline; }
+.atlas-map-svg { display: block; width: 100%; height: auto; overflow: visible; }
+.atlas-track-bands rect { fill: var(--as-band); }
+.atlas-track-rules path { stroke: var(--rule-soft); stroke-width: 1; }
+.atlas-edge { stroke-width: 1.3; }
+.atlas-arrow path { fill: var(--as-line); }
+.atlas-arrow-on path { fill: var(--accent); }
+.atlas-node rect { fill: var(--paper-3); stroke: var(--rule); stroke-width: 1; }
+.atlas-node text { font-family: var(--font-ui); font-size: 13px; fill: var(--ink-2); text-anchor: middle; font-variant-numeric: lining-nums tabular-nums; }
+.atlas-node:hover rect { stroke: var(--accent); }
+.atlas-map.is-focus .atlas-edge { opacity: .2; }
+.atlas-map.is-focus .atlas-node { opacity: .42; }
+.atlas-map .atlas-edge.is-on { opacity: 1; stroke: var(--accent); stroke-width: 2; }
+.atlas-map .atlas-node.is-on { opacity: 1; }
+.atlas-map .atlas-node.is-sel rect { stroke: var(--accent); stroke-width: 2.2; fill: var(--accent-soft); }
+.atlas-map .atlas-node.is-out { opacity: .18; }
+.atlas-map .atlas-edge.is-out { opacity: .06; }
+.atlas-tip { position: absolute; z-index: 30; max-width: min(22rem, calc(100vw - 24px)); padding: 7px 10px; background: var(--paper-3); color: var(--ink);
+             border: 1px solid var(--rule); border-radius: 6px; box-shadow: var(--shadow); font-size: var(--text-sm); line-height: 1.35; pointer-events: none; }
+.atlas-tip[hidden] { display: none; }
+.atlas-tip-rels { display: block; margin-top: var(--au-q); font-size: var(--text-xs); line-height: 1.4; color: var(--ink-2); }
+.atlas-tip-rel { display: block; }
+
+/* The key, as the map's legend */
+.atlas-key { padding: var(--au-h) 0; border-bottom: 1px solid var(--rule-soft); }
+.atlas-key-h { margin: 0 0 var(--au-q); font-size: var(--text-xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-key-cols { display: grid; gap: var(--au-h) 32px; grid-template-columns: minmax(0, 1fr); }
+.atlas-key-sub { margin: 0 0 var(--au-q); font-size: var(--text-sm); color: var(--ink-3); font-style: italic; }
+.atlas-key-status { margin: 0; display: grid; gap: var(--au-q) 24px; grid-template-columns: minmax(0, 1fr); }
+.atlas-key-item { min-width: 0; }
+.atlas-key-item dt { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: var(--text-sm); }
+.atlas-key-item dd { margin: 0 0 0 calc(.95em + 8px); color: var(--ink-2); font-size: var(--text-xs); line-height: 1.45; }
+.atlas-key-page { display: block; color: var(--ink-3); }
+.atlas-key-page .mark { width: 12px; height: 12px; margin: 0 .3em 0 .2em; vertical-align: -.12em; }  /* coloured by the page's .mark-<status> */
+.atlas-key-note { margin: var(--au-h) 0 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); }
+.atlas-rel-key { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--au-q); font-size: var(--text-sm); color: var(--ink-2); }
+.atlas-rel-key li { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.atlas-rel-plain { display: flex; align-items: center; gap: 10px; margin: 0; font-size: var(--text-sm); color: var(--ink-2); line-height: 1.45; }
+.atlas-rel-names { list-style: none; margin: 0; padding: 0; columns: 13rem auto; column-gap: 24px; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-2); }
+.atlas-rel-names li { break-inside: avoid; padding: 0 0 var(--au-q); }
+@container atlas-main (min-width: 34rem) { .atlas-key-cols { grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr); } }
+@container atlas-main (min-width: 48rem) { .atlas-key-status { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
+
+/* Formulae of the atlas: the page renderer's display and long inline boxes, in the atlas's own names,
+   with the page's behaviour: a formula wider than its box scrolls inside it, with a shadow at the edge that hides more. */
+.atlas .atlas-math-display { display: block; max-width: 100%; margin: .75em 0; padding: .25em .1em; overflow-x: auto; overflow-y: hidden; }
+.atlas .atlas-math-display math { display: block math; }
+.atlas .atlas-math-long { display: inline-block; max-width: 100%; overflow-x: auto; overflow-y: hidden; vertical-align: middle; padding: 2px 0; }
+.atlas .atlas-math-display, .atlas .atlas-math-long {
+  scrollbar-width: thin; scrollbar-color: var(--rule) transparent;
+  background:
+    linear-gradient(90deg, var(--surface, var(--paper)) 35%, transparent) left center / 1.6em 100% no-repeat local,
+    linear-gradient(270deg, var(--surface, var(--paper)) 35%, transparent) right center / 1.6em 100% no-repeat local,
+    radial-gradient(farthest-side at 0 50%, var(--scroll-cue, rgba(0, 0, 0, .2)), transparent) left center / .55em 100% no-repeat scroll,
+    radial-gradient(farthest-side at 100% 50%, var(--scroll-cue, rgba(0, 0, 0, .2)), transparent) right center / .55em 100% no-repeat scroll;
+}
+.atlas .atlas-math-display:focus-visible, .atlas .atlas-math-long:focus-visible { outline-offset: 0; }
+.atlas .atlas-math-display::-webkit-scrollbar, .atlas .atlas-math-long::-webkit-scrollbar { height: 6px; }
+.atlas .atlas-math-display::-webkit-scrollbar-thumb, .atlas .atlas-math-long::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 3px; }
+
+/* A claim named in a list: number, mark, title. */
+.atlas-num { display: inline-block; min-width: 1.5em; color: var(--ink-3); font-size: var(--text-xs); text-align: right;
+             font-variant-numeric: lining-nums tabular-nums; }
+.atlas-link { color: var(--ink); text-decoration: none; }
+.atlas-link .atlas-mark { margin: 0 .3em 0 .25em; }
+.atlas-link:hover .atlas-link-title, .atlas-link:focus-visible .atlas-link-title { color: var(--accent); text-decoration: underline;
+  text-decoration-thickness: .06em; text-underline-offset: .18em; }
+.atlas-claimlist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--au-q); }
+.atlas-claimlist .atlas-link { display: grid; grid-template-columns: 1.6em auto minmax(0, 1fr); align-items: baseline; column-gap: 2px;
+                               padding: 1px 4px 1px 0; border-radius: 4px; line-height: 1.32; }
+.atlas-claimlist .atlas-link .atlas-mark { align-self: center; margin: 0 .35em 0 .2em; }
+.atlas-claimlist .atlas-link:hover { background: var(--paper-2); }
+.atlas-more { margin-top: var(--au-q); }
+.atlas-more-h { cursor: pointer; color: var(--accent); font-size: var(--text-xs); letter-spacing: .04em; }
+.atlas-more[open] > .atlas-more-h { margin-bottom: var(--au-q); }
+.atlas-item-hyps { margin: 0 0 var(--au-q) 1.9em; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); }
+.atlas-item-hyps ol { margin: 0; padding-left: 1.3em; }
+.atlas-item-hyps .atlas-note-label { display: block; }
+
+/* Domains */
+.atlas-domains { display: grid; gap: var(--au-h); grid-template-columns: minmax(0, 1fr); }
+@container atlas-main (min-width: 44rem) { .atlas-domains { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+.atlas-domain { min-width: 0; padding: var(--au-h) calc(var(--au-h) * 1.15); background: var(--paper-3); border: 1px solid var(--rule-soft); border-radius: var(--radius); }
+.atlas-domain-h { font-size: var(--text-h3); line-height: 1.24; margin: 0 0 var(--au-q); }
+.atlas-domain-summary { font-size: var(--text-sm); line-height: 1.5; color: var(--ink-2); }
+.atlas-domain-summary p { margin: 0 0 var(--au-h); }
+.atlas-groups { display: grid; gap: var(--au-h); }
+.atlas-group-h { display: flex; align-items: center; gap: 7px; margin: 0 0 var(--au-q); font-size: var(--text-xs); font-weight: 400;
+                 letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-group .atlas-claimlist, .atlas-bucket .atlas-claimlist { font-size: var(--text-sm); }
+.atlas-conventions { margin: 0 0 var(--au-h); padding: var(--au-q) 0 var(--au-q) var(--au-h); border-left: 2px solid var(--rule); font-size: var(--text-sm); color: var(--ink-2); line-height: 1.5; }
+.atlas-conventions ul { margin: 0; padding-left: 1.2em; display: grid; gap: var(--au-q); }
+.atlas-path-note { margin: 0 0 var(--au-q); font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); font-style: italic; }
+.atlas-domain-comps { margin: var(--au-h) 0 0; padding-top: var(--au-q); border-top: 1px solid var(--rule-soft); font-size: var(--text-xs); color: var(--ink-3); }
+.atlas-domain:target { box-shadow: 0 0 0 2px var(--accent-soft), var(--shadow); }
+
+/* Index */
+.atlas-index { margin: 0; min-width: 0; }
+.atlas-table-wrap { overflow-x: auto; }
+/* A long index (more than forty claims) scrolls in its own box on screen, its head kept in view, so that the
+   parts after it stay near; the filters above narrow it. Print shows every row. */
+.atlas-index-long .atlas-table-wrap { max-height: min(40rem, 72vh); overflow: auto; overscroll-behavior: contain; border: 1px solid var(--rule-soft);
+                                       border-radius: var(--radius); background: var(--paper); }
+.atlas-index-long .atlas-table thead th { position: sticky; top: 0; z-index: 1; background: var(--paper); }
+.atlas-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); line-height: 1.32; }
+.atlas-table caption { text-align: left; caption-side: top; padding: 0 0 var(--au-q); }
+.atlas-table th, .atlas-table td { padding: var(--au-q) 8px; border-bottom: 1px solid var(--rule-soft); text-align: left; vertical-align: baseline; font-weight: 400; }
+.atlas-table thead th { font-size: var(--text-xs); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); border-bottom: 1px solid var(--rule); white-space: nowrap; }
+.atlas-table tbody tr:hover > * { background: var(--paper-2); }
+.atlas-table .atlas-col-num { width: 2.6em; text-align: right; color: var(--ink-3); font-variant-numeric: lining-nums tabular-nums; padding-right: 4px; }
+.atlas-table .atlas-col-n { width: 3.6em; text-align: right; font-variant-numeric: lining-nums tabular-nums; color: var(--ink-2); }
+.atlas-table .atlas-col-status { white-space: nowrap; color: var(--ink-2); }
+.atlas-table .atlas-col-status .atlas-mark { margin-right: .4em; }
+.atlas-table .atlas-col-domain { color: var(--ink-2); }
+.atlas-table .atlas-col-domain a { color: inherit; }
+.atlas-table th.atlas-col-claim { min-width: 12em; }
+.atlas-row-domain { display: none; font-size: var(--text-xs); color: var(--ink-3); }
+.atlas-table tr.is-sel > * { background: var(--accent-soft); }
+.atlas-table tr.is-sel th .atlas-link-title { font-weight: 600; }
+.atlas-table tr[hidden] { display: none; }
+
+/* Filters (script) */
+.atlas-tools { display: grid; gap: var(--au-q); margin: 0 0 var(--au-h); padding: var(--au-h) 0; border-top: 1px solid var(--rule-soft); border-bottom: 1px solid var(--rule-soft); }
+.atlas-words { display: flex; flex-wrap: wrap; align-items: center; gap: var(--au-q) 12px; }
+.atlas-words label { font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-words input { flex: 1 1 14rem; min-width: 0; font: inherit; font-size: var(--text-sm); color: var(--ink); background: var(--paper-3);
+                     border: 1px solid var(--ink-4); border-radius: var(--radius); padding: 7px 10px; -webkit-appearance: none; appearance: none; }
+.atlas-words input::placeholder { color: var(--ink-3); opacity: 1; }
+.atlas-filter-note { margin: 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); }
+.atlas-chips { display: flex; flex-wrap: wrap; align-items: center; gap: var(--au-q) 6px; }
+.atlas-chips-label { font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-right: 4px; }
+.atlas-chip-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 3px 11px 3px 9px; border: 1px solid var(--rule);
+                  border-radius: 999px; background: var(--paper-3); color: var(--ink-2); font: inherit; font-size: var(--text-xs); line-height: 1.25;
+                  cursor: pointer; text-align: left; }
+.atlas-chip-btn:hover { border-color: var(--ink-4); color: var(--ink); }
+.atlas-chip-btn[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); box-shadow: inset 0 0 0 1px var(--accent); }
+.atlas-chip-btn .atlas-mark { width: 12px; height: 12px; }
+.atlas-count { margin: 0; font-size: var(--text-sm); color: var(--ink-3); }
+
+/* A claim in full */
+.atlas-claim-group { margin-bottom: var(--au-1); }
+.atlas-claim-group-h { font-size: var(--text-h3); font-weight: 600; line-height: 1.24; margin: 0 0 var(--au-h); color: var(--ink-2); }
+.atlas-claim { position: relative; min-width: 0; margin: 0 0 var(--au-h); padding: var(--au-h) calc(var(--au-h) * 1.15) var(--au-h) calc(var(--au-h) * 1.3);
+               background: var(--paper-3); border: 1px solid var(--rule-soft); border-radius: var(--radius); --surface: var(--paper-3); }
+.atlas-claim::before { content: ''; position: absolute; left: -1px; top: -1px; bottom: -1px; width: 3px; border-radius: var(--radius) 0 0 var(--radius); background: var(--as); }
+.as-checked, .ac-checked { --as: var(--as-checked); }
+.as-conditional, .ac-conditional { --as: var(--as-conditional); }
+.as-scoped-negative, .ac-scoped-negative { --as: var(--as-negative); }
+.as-remaining, .ac-remaining { --as: var(--as-remaining); }
+.atlas-claim.as-remaining { background: transparent; border-style: dashed; --surface: var(--paper); }
+.atlas-claim-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--au-q) 12px; margin: 0 0 var(--au-q); font-size: var(--text-xs); }
+.atlas-chip { display: inline-flex; align-items: center; gap: 6px; padding: 1px 9px 1px 7px; border-radius: 999px; color: var(--as);
+              background: color-mix(in srgb, var(--as) 11%, transparent); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
+.atlas-chip .atlas-mark { width: 12px; height: 12px; }
+.atlas-claim-no { color: var(--ink-3); letter-spacing: .06em; font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
+.atlas-claim-domain a, .atlas-claim-domain { color: var(--ink-3); }
+.atlas-claim-title { font-size: calc(var(--text-base) * 1.08); font-weight: 600; line-height: 1.28; margin: 0 0 var(--au-q); outline-offset: 3px; }
+.atlas-statement { line-height: 1.58; }
+.atlas-statement p { margin: 0 0 var(--au-h); }
+.atlas-hyp-block { margin: 0 0 var(--au-h); padding: var(--au-h) 0 0; border-top: 1px solid var(--rule-soft); }
+.atlas-hyps { margin: 0; padding-left: 1.4em; font-size: var(--text-sm); line-height: 1.5; display: grid; gap: var(--au-q); }
+.atlas-hyps li::marker { color: var(--ink-3); font-variant-numeric: lining-nums; }
+.atlas-note { margin: var(--au-q) 0 0; font-size: var(--text-xs); color: var(--ink-3); }
+.atlas-rel-block { margin-top: var(--au-h); padding-top: var(--au-h); border-top: 1px solid var(--rule-soft); }
+.atlas-rels, .atlas-join-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--au-q); font-size: var(--text-sm); }
+.atlas-rel { min-width: 0; }
+.atlas-rel[hidden] { display: none; }
+.atlas-rel.is-on { background: var(--accent-soft); box-shadow: -6px 0 0 var(--accent-soft), 6px 0 0 var(--accent-soft); border-radius: 2px; }
+.atlas-rel-sentence { line-height: 1.4; }
+.atlas-rel-label { display: inline-flex; align-items: center; gap: 6px; margin: 0 .25em; color: var(--ink-3); font-style: italic; white-space: nowrap; }
+.atlas-rel-label .atlas-swatch { width: 22px; }
+.atlas-rel-self { color: var(--ink-3); font-style: italic; }
+.atlas-rel-scope { display: block; margin: 0 0 0 1.6em; font-size: var(--text-xs); color: var(--ink-3); }
+.atlas-claim:target { box-shadow: 0 0 0 2px var(--accent-soft), var(--shadow); }
+
+/* Comparisons: the four lists, each under its own status rule: one column in a narrow box, two by two
+   from 30rem, four across from 62rem of the atlas column (that is, with no pane open on a wide screen). */
+.atlas-comparisons { display: grid; gap: var(--au-1); }
+.atlas-comparison { min-width: 0; padding-top: var(--au-h); border-top: 1px solid var(--rule); }
+.atlas-comparison > .atlas-claim-domain { margin: 0; font-size: var(--text-xs); }
+.atlas-comparison-h { font-size: var(--text-h3); line-height: 1.24; margin: 0 0 var(--au-q); }
+.atlas-overview { color: var(--ink-2); font-size: var(--text-sm); line-height: 1.5; }
+.atlas-overview p { margin: 0 0 var(--au-h); }
+.atlas-buckets { display: grid; gap: var(--au-h); grid-template-columns: minmax(0, 1fr); }
+@container atlas-main (min-width: 30rem) { .atlas-buckets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@container atlas-main (min-width: 62rem) { .atlas-buckets { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+.atlas-bucket { min-width: 0; padding: var(--au-q) 10px var(--au-h) 11px; border: 1px solid var(--rule-soft); border-radius: var(--radius); background: var(--paper-3);
+                border-top: 2px solid var(--ab); }
+.ab-checked { --ab: var(--as-checked); } .ab-conditional { --ab: var(--as-conditional); }
+.ab-scoped-negative { --ab: var(--as-negative); } .ab-remaining { --ab: var(--as-remaining); }
+.atlas-comparison:target .atlas-comparison-h { color: var(--accent); }
+
+/* Reading paths: an editorial order is a dotted rail; a path joined by recorded relations is a solid
+   rail. The rail carries no arrow: the direction of each joining relation is given in its sentence. */
+.atlas-paths { display: grid; gap: var(--au-1); }
+.atlas-path { min-width: 0; padding-top: var(--au-h); border-top: 1px solid var(--rule); }
+.atlas-path-h { font-size: var(--text-h3); line-height: 1.24; margin: 0 0 var(--au-q); }
+.atlas-path-kind { margin: 0 0 var(--au-q); font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); }
+.atlas-kind-tag { display: inline-block; margin-right: .4em; padding: 0 8px; border: 1px solid var(--ink-4); border-radius: 999px; letter-spacing: .06em;
+                  text-transform: uppercase; color: var(--ink-2); font-size: var(--text-xs); }
+.ap-editorial .atlas-kind-tag { border-style: dashed; }
+.atlas-path-summary { color: var(--ink-2); font-size: var(--text-sm); line-height: 1.5; }
+.atlas-path-summary p { margin: 0 0 var(--au-q); }
+.atlas-path-tools { margin: 0 0 var(--au-h); }
+.atlas-stages { list-style: none; margin: var(--au-h) 0 0; padding: 0 0 0 22px; position: relative; display: grid; gap: var(--au-h); }
+.atlas-stages::before { content: ''; position: absolute; left: 6px; top: .5em; bottom: .5em; border-left: 2px dotted var(--ink-4); }
+.ap-dependency .atlas-stages::before { border-left: 2px solid var(--ink-3); }
+.atlas-stage { position: relative; min-width: 0; }
+.atlas-stage::before { content: ''; position: absolute; left: -21px; top: .45em; width: 10px; height: 10px; border-radius: 50%;
+                       background: var(--paper); border: 2px solid var(--ink-3); }
+.atlas-stage-h { margin: 0 0 var(--au-q); font-size: calc(var(--text-base) * 1.08); font-weight: 600; line-height: 1.28; }
+.atlas-stage-n { margin-right: .4em; font-size: var(--text-xs); font-weight: 400; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-stage-desc { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.5; }
+.atlas-stage-desc p { margin: 0 0 var(--au-q); }
+.atlas-stage .atlas-claimlist { font-size: var(--text-sm); }
+.atlas-join { margin: 0 0 var(--au-q); padding: var(--au-q) 10px; border-left: 2px solid var(--rule); background: var(--paper-2); border-radius: 0 4px 4px 0; }
+.atlas-join-back { font-size: var(--text-xs); color: var(--ink-3); font-style: italic; }
+.atlas-path:target .atlas-path-h { color: var(--accent); }
+.atlas-stage.is-here > .atlas-stage-h { color: var(--accent); }
+.atlas-stage.is-here::before { background: var(--accent); border-color: var(--accent); }
+
+/* The pane (script): the last part, showing the claim the address names, framed by the pane alone. */
+.atlas-pane-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 var(--au-h); padding: 0 0 var(--au-q);
+                   border-bottom: 1px solid var(--rule-soft); }
+.atlas-pane-label { margin: 0; font-size: var(--text-xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
+.atlas-pane-empty { margin: var(--au-q) 0; color: var(--ink-3); font-size: var(--text-sm); font-style: italic; }
+.atlas-pane-empty[hidden], .atlas-pathbar[hidden], .atlas-hidden-note[hidden] { display: none; }
+.atlas-pathbar { margin: 0 0 var(--au-h); padding: var(--au-q) 10px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-2); font-size: var(--text-sm); }
+.atlas-pathbar p { margin: 0 0 var(--au-q); }
+.atlas-pathbar .atlas-kind-tag { margin: 0 0 0 .3em; }
+.atlas-pathbar-where { color: var(--ink-3); font-size: var(--text-xs); }
