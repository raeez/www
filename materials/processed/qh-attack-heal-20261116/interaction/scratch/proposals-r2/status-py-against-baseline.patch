     def statement_id(self, s):
         sid = (s.get('id') or '').strip()
-        return 's-' + ident(sid) if sid else ''
+        if sid:
+            return 's-' + ident(sid)
+        # A statement without an id is addressed by its title, by the rule status.js applies at run time
+        # ('s-' + ident(title), then -2, -3 ... in page order), so a link made with or without the script is the same.
+        key = id(s)
+        if key not in self.given_ids:
+            base = 's-' + ident(s.get('title') or '')
+            sid, n = base, 2
+            while sid in self.reserved_ids or sid in self.given_ids.values():
+                sid, n = f'{base}-{n}', n + 1
+            self.given_ids[key] = sid
+        return self.given_ids[key]
 
