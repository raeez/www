+/* History steps are asynchronous: wait until the address has changed (or a second has passed), then a moment more. */
+async function traverse(p, step) {
+  const before = p.w.location.href;
+  step();
+  for (let i = 0; i < 40 && p.w.location.href === before; i++) await sleep(25);
+  await sleep(60);
+}
