+/* The monograph: a book in parts and chapters, read one chapter at a time by the reader script, with the former status page
+   kept whole as its reference volume. It shares the page's tokens: the type, the 1.2 scale, the paper
+   and ink, the accent, and one set of status marks and colours, used here only for mathematical status.
+   Proportion: one reading measure of 31 body sizes (about 70 characters); a margin column for the chapter's place
+   in the book; numbers of sections and chapters hang in the left margin on a wide screen; space in quarters, halves
+   and multiples of the body line. The book's map is one grid of columns (a column per chapter, a narrower gap
+   between parts) shared by the front matter's map, its routes and every chapter's locator. */
+:root {
+  --mg-measure: calc(var(--text-base) * 31);
+  --mg-aside: 15rem;
+  --mg-gap: clamp(28px, 3.6vw, 56px);
+  --mg-frame: calc(var(--mg-measure) + var(--mg-gap) + var(--mg-aside));
+  --mg-hang: 3.4rem;
+  --mg-bg: var(--paper);
+  --text-ch: calc(var(--text-base) * 2.0736);
+  --text-ch-no: calc(var(--text-base) * 3.583);
+  --sh-edge: color-mix(in srgb, var(--ink) 24%, transparent);
+}
+
+/* The reading bar: served with the site's link (and, for a page without its script, links to the contents and
+   the reference); the reader script adds the book's title, where the reader is, the previous and next chapter and search. */
+.mg-bar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: .25rem 1rem; min-height: var(--bar);
+          padding: 6px max(var(--gutter), env(safe-area-inset-left)); background: var(--bar-bg);
+          border-bottom: 1px solid var(--rule-soft); -webkit-backdrop-filter: saturate(1.2) blur(8px); backdrop-filter: saturate(1.2) blur(8px);
+          font-size: var(--text-sm); line-height: var(--lh-compact); }
+.mg-bar a { text-decoration: none; color: var(--ink-2); }
+.mg-bar a:hover { color: var(--accent); }
+.mg-site { flex: none; color: var(--ink-3) !important; font-variant-caps: all-small-caps; letter-spacing: .06em; font-size: 1.06em; }
+.mg-bar-static { display: flex; gap: 1rem; margin-left: auto; }
+body:has(main[data-reader-on]) .mg-bar-static { display: none; }
+.reader-home { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink) !important;
+               font-style: italic; padding-left: 1rem; border-left: 1px solid var(--rule); }
+.reader-contents-toggle { flex: 1 1 auto; min-width: 0; display: flex; align-items: baseline; gap: .6rem; padding: 6px 10px; margin: 0;
+                          border: 1px solid transparent; border-radius: 5px; background: transparent; cursor: pointer; text-align: left;
+                          color: var(--ink-2); line-height: var(--lh-compact); }
+.reader-contents-toggle:hover, .reader-contents-toggle[aria-expanded='true'] { background: var(--paper-2); color: var(--ink); }
