+.mg-display .math-display { margin: 0; padding: .2em 0; }
+.math-display, .math-long {
+  background:
+    linear-gradient(90deg, var(--mg-bg) 35%, transparent) left center / 1.6em 100% no-repeat local,
+    linear-gradient(270deg, var(--mg-bg) 35%, transparent) right center / 1.6em 100% no-repeat local,
+    radial-gradient(farthest-side at 0 50%, var(--sh-edge), transparent) left center / .7em 100% no-repeat scroll,
+    radial-gradient(farthest-side at 100% 50%, var(--sh-edge), transparent) right center / .7em 100% no-repeat scroll;
+  background-color: transparent;
+}
+.mg-display math[style*='--fw'] { font-size: clamp(.86em, calc(100cqi / (var(--fw) * .84)), 1em); }
+.mg-display { container-type: inline-size; }
+.mg-display:has(math[style*='--fw']) { container-type: normal; }
+.mg-display:has(math[style*='--fw']) > .math-display { container-type: inline-size; }
+
+/* Results, definitions and examples: the label is the author's lead-in, run into the first paragraph, with the status
+   mark of the atlas; a rule at the left in the status's colour, dashed where the question is open. */
+.mg-env { position: relative; margin: var(--s3) 0; padding: .1rem 0 .1rem 1rem; border-left: 2px solid var(--rule); }
+.mg-env > p:first-child, .mg-env > .mg-env-alone + * { text-indent: 0 !important; }
+.mg-env-label { font-weight: 600; color: var(--ink); hyphens: manual; }
+.mg-env-label .mark { margin-right: .32em; vertical-align: -.12em; }
+.mg-env-alone { margin-bottom: .2em !important; }
+.mg-env-theorem { border-left-color: var(--st-checked); }
+.mg-env-conditional { border-left-color: var(--st-conditional); }
+.mg-env-conjecture { border-left: 2px dashed var(--st-conjecture); }
+.mg-env-heuristic { border-left: 2px dotted var(--st-heuristic); }
+.mg-env-open { border-left: 2px dashed var(--st-open); }
+.mg-env-counterexample { border-left-color: var(--st-refuted-form); }
+.mg-env-definition { --mg-bg: color-mix(in srgb, var(--accent-soft) 55%, var(--paper)); border-left-color: var(--accent);
+                     background: var(--mg-bg); padding: .55rem 1rem .6rem; border-radius: 0 6px 6px 0; }
+.mg-env-example { --mg-bg: var(--paper-2); border-left: 0; background: var(--mg-bg); padding: .6rem 1rem .7rem; border-radius: 6px; }
+.mg-env-remark, .mg-env-construction { border-left: 0; padding-left: 0; }
+.mg-env-remark .mg-env-label, .mg-env-construction .mg-env-label { font-weight: 400; font-style: italic; }
+.mg-env p + p { text-indent: 1.5em; }
+.mg-proof { margin: var(--s2) 0 var(--s3); }
+.mg-proof .mg-env-label { font-weight: 400; font-style: italic; }
+.mg-qed { float: right; margin-left: 1em; color: var(--ink-3); }
+.mg-qed-line { text-align: right; }
+
+.mg-list { margin: .5em 0 .6em; padding-left: 1.6em; }
+.mg-list li { margin: .15em 0; padding-left: .2em; }
+.mg-list li > p { text-indent: 0 !important; }
+.mg-quote { margin: var(--s2) 0; padding-left: 1.2em; border-left: 1px solid var(--rule); color: var(--ink-2); }
+.mg-table-wrap { margin: var(--s3) 0; overflow-x: auto; }
+.mg-table { border-collapse: collapse; font-size: var(--text-sm); line-height: var(--lh-compact); margin: 0 auto; }
+.mg-table thead th { border-bottom: 1px solid var(--ink-3); font-weight: 600; text-align: left; }
+.mg-table th, .mg-table td { padding: .35rem .8rem; vertical-align: baseline; }
+.mg-table tbody tr:last-child td { border-bottom: 1px solid var(--ink-3); }
+.mg-table { border-top: 1px solid var(--ink-3); }
+.mg-rule { border: 0; border-top: 1px solid var(--rule); margin: var(--s4) 0; }
+.mg-code { font-size: var(--text-sm); background: var(--paper-2); padding: .6rem .8rem; border-radius: 4px; overflow-x: auto; }
+.mg-transition { margin-top: var(--s4); padding-top: var(--s2); border-top: 1px solid var(--rule-soft); }
+
+/* A figure (the atlas lane's component inside): a full block of the chapter, taking the margin column when the chapter
+   leaves it free. */
+.mg-figure { margin: var(--s4) 0; }
+.mg-figure > figure { margin: 0; }
+
+/* An authored diagram: nodes are page text over the edges; each edge has its arrowhead (none when undirected) and its
+   number at its middle, and the lists under it state everything in full. One visual language per kind, never colour
+   alone: a defined map is a solid line with a solid head; a functor a solid line with an open chevron; a construction
+   a long-dashed line whose label is written on it; an open comparison dashed in the open colour with a hollow head;
+   a reading relation dotted and grey, navigation and never a map. */
+.mg-diagram { margin: 0; container-type: inline-size; --mg-bg: var(--paper); }
+.mg-dg-title { margin: 0 0 .35rem; font-weight: 600; text-indent: 0 !important; }
+.mg-dg-legend { list-style: none; margin: 0 0 var(--s2); padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.2rem;
+                font-size: var(--text-sm); line-height: var(--lh-compact); color: var(--ink-2); }
+.mg-dg-key { display: inline-flex; align-items: center; gap: .45rem; }
+.mg-dg-sample { flex: none; width: 2.2em; height: 0; border-top: 1.5px solid var(--ink-2); position: relative; }
+.mg-dg-key.is-functor .mg-dg-sample { border-top-width: 1.5px; }
+.mg-dg-key.is-functor .mg-dg-sample::after { content: ''; position: absolute; right: -1px; top: -4.6px; width: 6px; height: 6px;
+                                             border-top: 1.5px solid var(--ink-2); border-right: 1.5px solid var(--ink-2); transform: rotate(45deg); }
+.mg-dg-key.is-construction .mg-dg-sample { border-top: 1.5px dashed var(--ink-2); }
+.mg-dg-key.is-open_comparison .mg-dg-sample { border-top: 1.5px dashed var(--st-open); }
+.mg-dg-key.is-reading_relation .mg-dg-sample { border-top: 2px dotted var(--ink-4); }
+.mg-dg-key.is-equivalence .mg-dg-sample { border-top-width: 2.4px; border-color: var(--ink); }
+/* A drawing is never set below 0.78 of its size, where node boxes would meet; a narrower figure scrolls it inside its
+   own box, with a shadow at each edge it can scroll past. Layers run left to right only where the figure is wide
+   enough for all of them (k = the number of layers), else top to bottom. */
+.mg-dg-stage { position: relative; margin: 0 auto var(--s2); overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
+  background:
+    linear-gradient(90deg, var(--mg-bg) 35%, transparent) left center / 2em 100% no-repeat local,
+    linear-gradient(270deg, var(--mg-bg) 35%, transparent) right center / 2em 100% no-repeat local,
+    radial-gradient(farthest-side at 0 50%, var(--sh-edge), transparent) left center / .8em 100% no-repeat scroll,
+    radial-gradient(farthest-side at 100% 50%, var(--sh-edge), transparent) right center / .8em 100% no-repeat scroll; }
+.mg-dg-plot { position: relative; width: max(min(100%, var(--dg-w)), var(--dg-min)); margin: 0 auto; }
+.mg-dg-plot.is-vertical { display: none; }
+.mg-dg-stage.is-tall .mg-dg-plot.is-vertical { display: block; }
+@container (max-width: 374px) { .mg-dg-stage.k2 .mg-dg-plot.is-horizontal { display: none; } .mg-dg-stage.k2 .mg-dg-plot.is-vertical { display: block; } }
+@container (max-width: 562px) { .mg-dg-stage.k3 .mg-dg-plot.is-horizontal { display: none; } .mg-dg-stage.k3 .mg-dg-plot.is-vertical { display: block; } }
+@container (max-width: 749px) { .mg-dg-stage.k4 .mg-dg-plot.is-horizontal { display: none; } .mg-dg-stage.k4 .mg-dg-plot.is-vertical { display: block; } }
+@container (max-width: 936px) { .mg-dg-stage.k5 .mg-dg-plot.is-horizontal { display: none; } .mg-dg-stage.k5 .mg-dg-plot.is-vertical { display: block; } }
+.mg-dg-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+.mg-dg-edge { fill: none; stroke: var(--ink-2); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
+.mg-dg-head { fill: var(--ink-2); stroke: none; }
+.mg-dg-head.is-functor { fill: none; stroke: var(--ink-2); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+.mg-dg-edge.is-construction { stroke-dasharray: 9 4; }
+.mg-dg-edge.is-equivalence { stroke: var(--ink); stroke-width: 2.4; }
+.mg-dg-head.is-equivalence { fill: var(--ink); }
+.mg-dg-edge.is-open_comparison { stroke: var(--st-open); stroke-dasharray: 6 5; }
+.mg-dg-head.is-open_comparison { fill: var(--paper); stroke: var(--st-open); stroke-width: 1.4; }
+.mg-dg-edge.is-reading_relation { stroke: var(--ink-4); stroke-width: 1.2; stroke-dasharray: 1.5 4; stroke-linecap: round; }
+.mg-dg-head.is-reading_relation { fill: var(--ink-4); }
+.mg-dg-node { position: absolute; transform: translate(-50%, -50%); width: max-content; max-width: 9.5em; padding: .3em .65em;
+              border: 1.3px solid var(--ink-3); border-radius: 6px; background: var(--paper); color: var(--ink); text-align: center;
+              font-size: var(--text-sm); line-height: var(--lh-compact); hyphens: manual; z-index: 1; }
+.mg-dg-node.is-highlighted { border: 2px solid var(--accent); background: color-mix(in srgb, var(--accent-soft) 60%, var(--paper)); }
+.mg-dg-node-formula { display: block; margin-top: .15em; color: var(--ink-2); }
+.mg-dg-badge { position: absolute; transform: translate(-50%, -50%); min-width: 1.45em; padding: 0 .3em; border-radius: 999px;
+               background: var(--paper); border: 1px solid var(--rule); color: var(--ink-2); font-size: 12.5px; line-height: 1.45;
+               text-align: center; font-variant-numeric: lining-nums tabular-nums; z-index: 2; }
+.mg-dg-badge.is-construction { border-radius: 6px; max-width: 12em; width: max-content; padding: .1em .45em; text-align: left; }
+.mg-dg-badge-words { display: inline; margin-left: .35em; color: var(--ink); }
+.mg-dg-badge.is-open_comparison { border-color: var(--st-open); color: var(--st-open); }
+.mg-dg-badge.is-reading_relation { border-style: dotted; color: var(--ink-3); }
+.mg-dg-caption { margin: 0 0 var(--s2); color: var(--ink-2); font-size: var(--text-sm); text-indent: 0; }
+.mg-dg-recstatus { margin: 0 0 .5rem; font-size: var(--text-sm); color: var(--ink-2); display: flex; gap: .35em; align-items: center; text-indent: 0 !important; }
+.mg-dg-block { margin: 0 0 .7rem; font-size: var(--text-sm); line-height: 1.45; }
+.mg-dg-h { margin: 0 0 .2rem; color: var(--ink-3); font-variant-caps: all-small-caps; letter-spacing: .06em; text-indent: 0 !important; }
+.mg-dg-ul { margin: 0; padding-left: 1.2em; }
+.mg-dg-ul li { margin: .1rem 0; }
+.mg-dg-eqs { list-style: none; padding-left: 0; }
+.mg-dg-rels { list-style: none; padding-left: 0; }
+.mg-dg-rel-status { display: inline-flex; align-items: center; gap: .3em; color: var(--ink-3); font-variant-caps: all-small-caps; letter-spacing: .04em; }
+.mg-dg-not { padding: .45rem .7rem; border-left: 2px solid var(--rule); background: var(--paper-2); --mg-bg: var(--paper-2); }
+.mg-dg-list { list-style: none; margin: 0 0 var(--s2); padding: 0; font-size: var(--text-sm); line-height: var(--lh-compact); display: grid; gap: .45rem; }
+.mg-dg-item { display: grid; grid-template-columns: 1.9em minmax(0, 1fr); gap: .45rem; align-items: baseline; }
+.mg-dg-n { justify-self: center; min-width: 1.45em; padding: 0 .3em; border-radius: 999px; border: 1px solid var(--rule); text-align: center;
+           color: var(--ink-2); font-size: 12.5px; line-height: 1.45; font-variant-numeric: lining-nums tabular-nums; }
+.mg-dg-item.is-open_comparison .mg-dg-n { border-color: var(--st-open); color: var(--st-open); }
+.mg-dg-item.is-reading_relation .mg-dg-n { border-style: dotted; }
+.mg-dg-ends { color: var(--ink); }
+.mg-dg-arrow { color: var(--ink-3); margin: 0 .15em; }
+.mg-dg-label { color: var(--ink); }
+.mg-dg-kind { color: var(--ink-3); font-style: italic; }
+.mg-dg-status { display: inline-flex; align-items: center; gap: .3em; margin-left: .35em; color: var(--ink-2); }
+.mg-dg-hyp { display: block; margin-top: .15rem; color: var(--ink-2); }
+.mg-dg-hyp-h { font-variant-caps: all-small-caps; letter-spacing: .05em; color: var(--ink-3); margin-right: .25em; }
+.mg-dg-nodes { list-style: none; margin: 0 0 var(--s2); padding: 0; font-size: var(--text-sm); line-height: 1.4; display: grid; gap: .35rem; }
+.mg-dg-nd { padding-left: .7rem; border-left: 2px solid var(--rule-soft); }
+.mg-dg-nd.is-highlighted { border-left-color: var(--accent); }
+.mg-dg-nd-name { display: block; color: var(--ink); }
+.mg-dg-desc { display: block; color: var(--ink-2); }
+.mg-dg-more { margin: 0 0 var(--s2); font-size: var(--text-sm); }
+.mg-dg-more > summary { cursor: pointer; color: var(--accent); margin-bottom: .4rem; }
+@media print {
+  .mg-dg-stage { overflow: visible; background: none; }
+  .mg-dg-plot { width: min(100%, var(--dg-w)); }
+  .mg-dg-more > :not(summary) { display: block !important; }
+  .mg-dg-more > summary { display: none; }
+}
+
+/* The end of a chapter: the next chapter as the continuation of the argument, the previous one quietly. */
+.mg-ch-end { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: var(--s3) var(--mg-gap); margin: var(--s5) 0 0;
+             padding: var(--s3) 0 0; border-top: 1px solid var(--rule); max-width: var(--mg-frame); }
+.mg-ch-end a { display: block; padding: .6rem .2rem; text-decoration: none; color: var(--ink); border-radius: 6px; }
+.mg-end-prev { grid-column: 1; align-self: start; }
+.mg-end-next { grid-column: 2; padding: .8rem 1.1rem !important; background: var(--paper-2); }
+.mg-end-next:hover { background: color-mix(in srgb, var(--accent-soft) 70%, var(--paper-2)); }
+.mg-end-prev:hover .mg-end-title { color: var(--accent); }
+.mg-end-dir { display: block; color: var(--ink-3); font-size: var(--text-sm); font-variant-caps: all-small-caps; letter-spacing: .07em; margin-bottom: .2rem; }
+.mg-end-ch { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .55rem; align-items: baseline; }
+.mg-end-no { color: var(--accent); font-variant-numeric: oldstyle-nums; }
+.mg-end-next .mg-end-ch { font-size: var(--text-h3b); line-height: var(--lh-display); }
+.mg-end-next .mg-end-no { font-size: 1.3em; }
+.mg-end-prev .mg-end-ch { color: var(--ink-2); }
+.mg-end-summary { display: block; margin-top: .4rem; color: var(--ink-2); font-style: italic; }
+
+/* The reference volume: the former page, unchanged inside; its overview is one place of the reader. */
+.mg-ref-overview { display: block; }
+.essay .essay-byline { text-align: center; text-indent: 0; }
+
+/* Reminders for cross-references (the reader script), a card beside the link; a bottom sheet on a narrow screen. */
+.reader-peek { position: fixed; z-index: 40; left: clamp(8px, var(--peek-x, 8px), calc(100vw - min(30rem, calc(100vw - 16px)) - 8px));
+               top: calc(var(--peek-y, 80px) + 8px); width: min(30rem, calc(100vw - 16px)); max-height: min(60vh, 32rem); overflow: auto;
+               padding: .7rem 1rem .8rem; background: var(--paper-3); color: var(--ink); border: 1px solid var(--rule); border-radius: 8px;
+               box-shadow: var(--shadow); font-size: var(--text-sm); line-height: 1.45; --mg-bg: var(--paper-3); }
+.reader-peek[hidden] { display: none; }
+.reader-peek[data-placement='above'] { top: auto; bottom: calc(100vh - var(--peek-y, 80px) + 8px); }
+.reader-peek-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .4rem; }
+.reader-peek-where { margin: 0; color: var(--ink-3); font-variant-caps: all-small-caps; letter-spacing: .06em; }
+.reader-peek-close { padding: 0 .5rem; line-height: 1.4; }
+.reader-peek-body > * { margin-top: 0; }
+.reader-peek-body .mg-env, .reader-peek-body .mg-display { margin: .3rem 0; }
+.reader-peek-foot { margin: .6rem 0 0; }
+.reader-peek-go { color: var(--accent); }
+
+/* Search (the reader script): a panel under the reading bar. */
+.reader-search { position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100vh - var(--reader-bar-h, var(--bar)) - 12px); overflow: auto;
+                 padding: var(--s3) max(var(--gutter), calc(50% - var(--mg-frame) / 2)); background: var(--paper-3);
+                 border-bottom: 1px solid var(--rule); box-shadow: var(--shadow); font-size: var(--text-base); overscroll-behavior: contain; }
+.reader-search[hidden] { display: none; }
+.reader-search-field { display: flex; align-items: center; gap: .6rem; }
+.reader-search-label { color: var(--ink-3); font-variant-caps: all-small-caps; letter-spacing: .06em; }
+.reader-search-input { flex: 1; min-width: 0; font: inherit; padding: .45rem .7rem; border: 1px solid var(--rule); border-radius: 6px;
+                       background: var(--paper); color: var(--ink); }
+.reader-search-input:focus { outline: 2px solid var(--focus); outline-offset: 1px; }
+.reader-search-scopes { display: flex; flex-wrap: wrap; gap: .35rem; margin: .7rem 0 .2rem; }
+.reader-scope { font: inherit; font-size: var(--text-sm); padding: 2px 10px; border: 1px solid var(--rule); border-radius: 999px; background: transparent;
+                color: var(--ink-2); cursor: pointer; }
+.reader-scope[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
+.reader-scope-count { margin-left: .35rem; color: inherit; opacity: .7; font-variant-numeric: lining-nums tabular-nums; }
+.reader-search-status, .reader-search-news { margin: .4rem 0; color: var(--ink-3); font-size: var(--text-sm); }
+.reader-search-news:empty { display: none; }
+.reader-group { margin: var(--s2) 0 0; }
+.reader-group-head { margin: 0 0 .3rem; color: var(--ink-3); font-size: var(--text-sm); font-variant-caps: all-small-caps; letter-spacing: .06em; }
+.reader-hits { list-style: none; margin: 0; padding: 0; }
+.reader-hit-link { display: block; padding: .45rem .6rem; border-radius: 5px; text-decoration: none; color: var(--ink); }
+.reader-hit-link:hover, .reader-hit-link:focus-visible { background: var(--paper-2); }
+.reader-hit-title { display: block; }
+.reader-hit-where { display: block; color: var(--ink-3); font-size: var(--text-sm); }
+.reader-hit-text { display: block; color: var(--ink-2); font-size: var(--text-sm); }
+.reader-hit mark, .reader-hit-text mark { background: color-mix(in srgb, var(--accent-soft) 85%, transparent); color: inherit; border-radius: 2px; }
+
+/* Wide screens: numbers of chapters and sections hang in the left margin; figures and wide displays take the margin
+   column beside the text. */
+@media (min-width: 1181px) {
+  .mg-ch-title { padding-left: 0; }
+  .mg-ch-no { position: absolute; right: calc(100% + 1.1rem); top: .02em; font-size: var(--text-ch); line-height: var(--lh-display); margin: 0; }
+  .mg-sec-head .mg-sec-no { position: absolute; right: calc(100% + 1rem); top: .08em; margin: 0; font-size: .82em; }
+  .mg-ch-text .mg-figure, .mg-ch-text .mg-display:has(math[style*='--fw']) { margin-right: calc(-1 * (var(--mg-gap) + var(--mg-aside))); }
+}
+/* Below that, the chapter's margin column moves above its text, as one band. */
+@media (max-width: 1180px) {
+  .mg-ch-frame { grid-template-columns: minmax(0, 1fr); max-width: var(--mg-measure); }
+  .mg-ch-aside { grid-column: 1; grid-row: 2; display: flex; flex-wrap: wrap; gap: 0 2rem; padding: var(--s2) 0 var(--s1); margin: 0 0 var(--s2);
+                 border-top: 1px solid var(--rule-soft); border-bottom: 1px solid var(--rule-soft); }
+  .mg-aside-block { flex: 1 1 13rem; padding-bottom: var(--s2); }
+  .mg-aside-block + .mg-aside-block { border-top: 0; padding-top: 0; }
+  .mg-aside-toc, .mg-aside-map { flex-basis: 100%; }
+  .mg-ch-aside .mg-dot { font-size: 12px; gap: 3px; }
+  .mg-ch-aside .mg-locator-plot { grid-template-rows: 2.8rem auto; }
+  .mg-ch-open { grid-row: 1; }
+  .mg-ch-text { grid-row: 3 !important; }
+  .mg-ch-end { max-width: var(--mg-measure); }
+  .mg-toc-part, .mg-toc-ref { grid-template-columns: minmax(0, 1fr); }
+  .mg-toc-chapters, .mg-toc-ref-list { grid-column: 1; grid-row: auto; margin-top: var(--s2); }
+  .mg-toc-part-summary, .mg-toc-ref-note { grid-column: 1; }
+  .reader-home { display: none; }
+}
+@media (max-width: 860px) {
+  .mg-site { display: none; }
+  .mg-band-title { font-size: .92em; }
+  .reader-step-title { display: none; }
+  .reader-position-part, .reader-position-section { display: none; }
+}
+@media (max-width: 640px) {
+  .mg-front { padding-top: var(--s4); }
+  .mg-front-title { font-size: calc(var(--text-base) * 2.2); }
+  .mg-map-plot { grid-template-rows: 5.5rem auto auto; }
+  .mg-band-title { display: none; }
+  .mg-band { padding-top: .4rem; }
+  .mg-route { grid-template-columns: minmax(0, 1fr); }
+  .mg-ch-title { font-size: calc(var(--text-base) * 1.6); }
+  .mg-ch-no { font-size: calc(var(--text-base) * 2.4); }
+  .mg-ch-end { grid-template-columns: minmax(0, 1fr); }
+  .mg-end-prev, .mg-end-next { grid-column: 1; }
+  .mg-end-next { order: -1; }
+  .mg-display.has-tag { grid-template-columns: minmax(0, 1fr) auto; column-gap: .6em; }
+  .mg-display.has-tag > .math-display { grid-column: 1; }
+  .mg-tag { grid-column: 2; }
+  .mg-env { padding-left: .75rem; }
+  .mg-env-example, .mg-env-definition { padding-right: .75rem; }
+  .mg-locator-plot { grid-template-rows: 1.9rem auto; }
+  .mg-dot { font-size: 0; gap: 0; }
+  .mg-dot.is-here { font-size: 12px; gap: 3px; }
+  .reader-step-label { display: none; }
+  .reader-contents-word { display: none; }
+  .reader-peek:not([hidden]) { left: 8px; right: 8px; width: auto; top: auto; bottom: 8px; max-height: 55vh; border-radius: 10px; }
+}
+@media (max-width: 480px) {
+  .mg-node { width: 100%; max-width: 1.2rem; border-width: 1.2px; }
+  .mg-node-no { display: none; }
+  .mg-nodes { margin-top: -.3rem; }
+  .mg-toc-ch { padding-left: 2.4rem; }
+  .mg-toc-no { width: 1.8rem; }
+  .reader-search-toggle { padding: 4px 9px; }
+}
+
+/* Print: the place being read (with the reader script: the title page and contents, one chapter, or one reference
+   place); without the script, the whole book, chapter after chapter from new pages, and no reference volume. Notices,
+   the bar and the reader's panels never print. */
+@media print {
+  :root { --mg-measure: 100%; --mg-bg: #fff; }
+  .mg-bar, .reader-bar, .reader-notices, .reader-peek, .reader-search, .skip { display: none !important; }
+  main[data-reader] > [hidden] { display: none !important; }
+  main[data-reader][data-reader-view='reference'] > :not([data-reference]):not(.reader-notices) { display: none !important; }
+  main[data-reader-view] > .mg-chapter[data-current] { break-before: auto; }
+  main[data-reader]:not([data-reader-view='reference']) > [data-reference] { display: none !important; }
+  .mg-front { padding: 0 0 6mm; max-width: none; }
+  .mg-front-title { font-size: 30pt; }
+  .mg-map { break-inside: avoid; }
+  .mg-map-plot { grid-template-rows: 30mm auto auto; }
+  .mg-toc { break-before: page; padding: 0; max-width: none; }
+  .mg-toc-part { break-inside: avoid; }
+  .mg-chapter { break-before: page; padding: 0; max-width: none; }
+  .mg-ch-frame { grid-template-columns: minmax(0, 1fr); }
+  .mg-ch-aside { grid-column: 1; grid-row: 2; display: flex; flex-wrap: wrap; gap: 0 8mm; border-top: .5pt solid #999; border-bottom: .5pt solid #999; margin-bottom: 4mm; }
+  .mg-aside-toc { display: none; }
+  .mg-ch-open { grid-row: 1; }
+  .mg-ch-text { grid-row: 3 !important; }
+  .mg-ch-text p, .mg-ch-open p { text-align: justify; }
+  .mg-ch-no { position: static; }
+  .mg-sec-head .mg-sec-no { position: static; }
+  .mg-sec-head { break-after: avoid; }
+  .mg-env, .mg-display, .mg-figure { break-inside: avoid; }
+  .math-display, .math-long { background: none !important; overflow: visible !important; }
+  .mg-ch-end { display: none; }
+  .mg-locator { break-inside: avoid; }
+  [data-reader-toc][data-drawer] { position: static; box-shadow: none; border: 0; max-height: none; width: auto; }
+  a { color: inherit; text-decoration: none; }
+}
