+
+.mg-sec { margin-top: var(--s5); }
+.mg-sec-head { position: relative; margin: 0 0 var(--s2); font-size: var(--text-h3b); font-weight: 600; line-height: var(--lh-display);
+               text-wrap: balance; hyphens: manual; }
