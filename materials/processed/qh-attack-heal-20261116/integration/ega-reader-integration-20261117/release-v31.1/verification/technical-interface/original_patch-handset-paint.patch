diff -ru a/compiler/quantum-holography-status/monograph.css b/compiler/quantum-holography-status/monograph.css
--- a/compiler/quantum-holography-status/monograph.css	2026-11-20 09:22:15
+++ b/compiler/quantum-holography-status/monograph.css	2026-11-20 09:23:07
@@ -74,6 +74,10 @@
 /* Places: the reader script shows one; the others are hidden until found. */
 main[data-reader] { display: block; padding-bottom: var(--s6); }
 main[data-reader] > [hidden='until-found'] { content-visibility: hidden; }
+/* While a page whose reader will run is still loading, its places are not laid out; the reader shows one of them as
+   soon as it starts. (The mark on the root is set in the head, and taken away if no reader starts.) A telephone then
+   lays out only what it shows and stays free to paint the page as it is scrolled. */
+html[data-reader-js] main[data-reader]:not([data-reader-on]) > :is(article[data-chapter], section[data-reference]) { content-visibility: hidden; }
 [data-revealed] { animation: mg-revealed 2.4s ease-out 1; border-radius: 3px; }
 @keyframes mg-revealed { from { box-shadow: 0 0 0 .4em color-mix(in srgb, var(--accent) 22%, transparent); background-color: color-mix(in srgb, var(--accent-soft) 70%, transparent); } }
 @media (prefers-reduced-motion: reduce) { [data-revealed] { animation: none; outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 4px; } }
