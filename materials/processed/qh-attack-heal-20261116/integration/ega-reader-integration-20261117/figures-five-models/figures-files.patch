+    if (v === null || v === undefined || typeof v === 'boolean' || !isFinite(v)) return '';
+    if (v !== 0 && (Math.abs(v) >= 1000 || Math.abs(v) < 0.001)) return v.toPrecision(3);
+    return v.toFixed(3).replace(/0+$/, '').replace(/\.$/, '');
+  }
