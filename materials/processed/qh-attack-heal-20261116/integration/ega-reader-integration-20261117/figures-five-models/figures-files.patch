+/* Figures of the reader. One figure answers the question of its section: a quiet head (the title and the links to
+   the chapter's equations), the record's domain and controls beside the drawing in the golden proportion
+   (1 : 1.618) when the figure is wide enough, and the authored caption under it. Layout follows the figure's own
+   width (a container), so a figure set in the reading column stacks rather than shrinking its labels.
+
+   Every mark keeps one meaning. Ink is a defined map, a curve or a label. The accent marks what the reader's
+   choice changes or singles out: the mean, the chosen region, the pole, the surviving basis vectors, the nonzero
+   entries, the unit. No dashed line is used: dashes are reserved for open comparisons. The page's tokens give
+   colour, type and rhythm. */
+.qh-fig { container-type: inline-size; margin: calc(var(--text-base) * 1.55 * 1.5) 0; padding: calc(var(--text-base) * 1.55 * .5) 0 0;
+          border-top: 1px solid var(--rule); --fig-au: calc(var(--text-base) * 1.55); }
+.qh-fig-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: calc(var(--fig-au) * .25) 16px;
+               margin: 0 0 calc(var(--fig-au) * .5); }
+.qh-fig-title { margin: 0; font-size: calc(var(--text-base) * 1.08); font-weight: 600; line-height: 1.28; }
+.qh-fig-refs { margin: 0; font-size: var(--text-xs); color: var(--ink-3); }
+.qh-fig-refs a { color: var(--ink-2); }
+.qh-fig-label { margin: 0 0 calc(var(--fig-au) * .25); font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3);
+                font-weight: 400; text-align: left; }
+.qh-fig-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--fig-au) * .75) 28px; align-items: start; }
+@container (min-width: 40rem) { .qh-fig-body:not(.qh-fig-body-single) { grid-template-columns: minmax(0, 1fr) minmax(0, 1.618fr); } }
+.qh-fig-body-single { gap: calc(var(--fig-au) * .6); }
+.qh-fig-side, .qh-fig-stage { min-width: 0; }
+.qh-fig-stage { container-type: inline-size; }
+.qh-fig-domain { margin: 0; font-size: var(--text-sm); line-height: 1.45; color: var(--ink-2); max-width: var(--measure); }
+.qh-fig-side .qh-fig-domain { margin-bottom: calc(var(--fig-au) * .5); }
+.qh-fig-note { margin: 2px 0 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); font-style: italic; }
+.qh-fig-explanation { display: block; margin: 4px 0 0; font-size: var(--text-sm); line-height: 1.45; color: var(--ink-2); }
+.qh-fig-strong { font-weight: 600; color: var(--ink); }
+
+/* Controls: an authored label, the current value, the range input (added by the script) */
+.qh-fig-controls { list-style: none; margin: 0 0 calc(var(--fig-au) * .5); padding: 0; display: grid; grid-template-columns: minmax(0, 1fr);
+                   gap: calc(var(--fig-au) * .25); }
+.qh-fig-control { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: 12px; }
+.qh-fig-control-label { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.35; }
+.qh-fig-control input[type="range"] { grid-column: 1 / -1; width: 100%; margin: 2px 0 0; accent-color: var(--accent); }
+.qh-fig-value { font-variant-numeric: lining-nums tabular-nums; color: var(--ink); }
+.qh-fig-invalid { margin: calc(var(--fig-au) * .25) 0 0; padding: calc(var(--fig-au) * .25) 10px; border-left: 2px solid var(--accent);
+                  background: var(--accent-soft); font-size: var(--text-xs); line-height: 1.45; color: var(--ink); }
+.qh-fig-invalid[hidden] { display: none; }
+.qh-fig button:focus-visible, .qh-fig input:focus-visible { outline: 2px solid var(--focus, var(--accent)); outline-offset: 2px; }
+
+/* Drawings: SVG at its natural size or smaller, never enlarged, so labels keep the size they were set at */
+.qh-fig-svg { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--font-text); }
+.qh-fig-svg text { fill: var(--ink); }
+.qh-fig-tick { font-family: var(--font-ui); font-size: 12px; fill: var(--ink-3) !important; font-variant-numeric: lining-nums tabular-nums; }
+.qh-fig-var { font-style: italic; font-family: var(--font-text); font-size: 14px; }
+.qh-fig-axis { fill: none; stroke: var(--ink-4); stroke-width: 1; }
+.qh-fig-more { fill: var(--ink-4); stroke: none; }
+.qh-fig-map { fill: none; stroke: var(--ink-2); stroke-width: 1.35; }
+.qh-fig-head-mark { fill: var(--ink-2); }
+.qh-fig-map-label { font-size: 14px; font-style: italic; fill: var(--ink-2) !important; paint-order: stroke; stroke: var(--paper); stroke-width: 4px; stroke-linejoin: round; }
+.qh-fig-mark-label { font-size: 13px; fill: var(--ink-2) !important; paint-order: stroke; stroke: var(--paper); stroke-width: 4px; stroke-linejoin: round; }
+.qh-fig-node-text { font-size: 17px; font-style: italic; }
+.qh-fig-sub { font-size: .74em; }
+
+/* Profiles: one curve per authored function over a finite window of its variable; the real-line integral is the
+   authored formula, written under the curve (no area is filled, so a window never reads as the whole mass). */
+.qh-fig-profiles { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--fig-au) * .6) 20px; }
+@container (min-width: 50rem) { .qh-fig-profiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+.qh-fig-profile { min-width: 0; max-width: 26rem; }
+.qh-fig-profile .qh-fig-svg { max-width: 360px; }
+.qh-fig-profile-label { margin: 0 0 2px; font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
+.qh-fig-integral { margin: 2px 0 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-2); }
+.qh-fig-integral .qh-fig-label { display: block; margin: 0; }
+.qh-fig-profile-caption { margin: 2px 0 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-3); }
+.qh-fig-curve { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }
+.qh-fig-mean { stroke: var(--accent); stroke-width: 1.4; }
+
+/* Values at the current parameters, and tables of parallel facts */
+.qh-fig-outputs { width: 100%; margin: calc(var(--fig-au) * .75) 0 0; border-collapse: collapse; font-size: var(--text-sm); line-height: 1.35; }
+.qh-fig-outputs caption { caption-side: top; }
+.qh-fig-outputs th, .qh-fig-outputs td { padding: calc(var(--fig-au) * .25) 8px; border-top: 1px solid var(--rule-soft); vertical-align: top;
+                                         text-align: left; font-weight: 400; }
+.qh-fig-outputs thead th { font-size: var(--text-xs); color: var(--ink-3); border-top: 0; vertical-align: bottom; }
+.qh-fig-outputs tbody th { color: var(--ink-2); width: 34%; }
+.qh-fig-num { text-align: right !important; width: 5.5em; }
+.qh-fig-formula { overflow-x: auto; }
+
+/* States: the authored cases; the chosen one carries the accent rule */
+.qh-fig-states { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--fig-au) * .5); }
+.qh-fig-state { min-width: 0; padding: calc(var(--fig-au) * .25) 0 calc(var(--fig-au) * .25) 12px; border-left: 2px solid var(--rule-soft); }
