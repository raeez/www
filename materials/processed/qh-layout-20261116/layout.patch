+
+/* ---------------------------------------------------------------------------------------------
+   Reading hierarchy. Statement cards carry their status as a tinted label; long formulas scroll
+   inside their own box with a shadow at the edge that hides more; the decisive questions set the
+   open question beside what is established toward it; each question section opens with an index.
+   --------------------------------------------------------------------------------------------- */
+:root { --scroll-cue: rgba(29, 27, 24, .2); --index-hover: var(--paper-2); }
+@media (prefers-color-scheme: dark) { :root:not([data-theme='light']) { --scroll-cue: rgba(0, 0, 0, .75); } }
+:root[data-theme='dark'] { --scroll-cue: rgba(0, 0, 0, .75); }
+
+/* The surface a formula scrolls over, so that its edge shadows blend with the card. */
+body { --surface: var(--paper); }
+.statement { --surface: var(--paper-3); }
+.st-open, .st-conjecture, .st-heuristic { --surface: var(--paper); }
+.card { --surface: var(--paper-3); }
+.gloss:target { --surface: var(--accent-soft); }
+
+/* Statement cards */
+.statement { padding: 18px 20px 16px 22px; }
+.statement-head { gap: 6px 10px; margin-bottom: .55em; }
+.status-chip { padding: 2px 9px 2px 7px; border-radius: 999px; line-height: 1.5;
+               background: color-mix(in srgb, var(--st) 11%, transparent); }
+.statement-title { margin-top: .15em; line-height: 1.24; }
+.statement-text { line-height: 1.6; }
+.statement-notes { border-top: 1px solid var(--rule-soft); padding-top: .6em; margin-top: .9em; }
+.principal .statement { padding: 22px 24px 20px 26px; }
+
+/* Long formulas */
+.math-display { margin: .75em 0; padding: .25em .1em; }
+.math-display, .math-long {
+  scrollbar-width: thin; scrollbar-color: var(--rule) transparent;
+  background:
+    linear-gradient(90deg, var(--surface) 35%, transparent) left center / 1.6em 100% no-repeat local,
+    linear-gradient(270deg, var(--surface) 35%, transparent) right center / 1.6em 100% no-repeat local,
+    radial-gradient(farthest-side at 0 50%, var(--scroll-cue), transparent) left center / .55em 100% no-repeat scroll,
+    radial-gradient(farthest-side at 100% 50%, var(--scroll-cue), transparent) right center / .55em 100% no-repeat scroll;
+}
+.math-display::-webkit-scrollbar, .math-long::-webkit-scrollbar { height: 6px; }
+.math-display::-webkit-scrollbar-thumb, .math-long::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 3px; }
+.math-display:focus-visible, .math-long:focus-visible { outline-offset: 0; }
+
+/* Status counts: a mark and a number per status. */
+.mix { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 9px; font-size: var(--text-xs); color: var(--ink-3);
+       font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
+.mix-item { display: inline-flex; align-items: center; gap: 3px; }
+.mix .mark { width: 11px; height: 11px; }
+.row-count { display: inline-flex; align-items: center; gap: 10px; }
+.row-count .mix { color: var(--ink-4); }
+
+/* Question index */
+.q-index { margin: 1.6em 0 clamp(28px, 4vw, 44px); border-top: 1px solid var(--rule); }
+.section.wide > .q-index { max-width: var(--measure); margin-left: auto; margin-right: auto; }
+.q-index-label { margin: .9em 0 .4em; font-size: var(--text-xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-4); }
+.q-index ol { list-style: none; margin: 0; padding: 0; }
+.q-index li { border-bottom: 1px solid var(--rule-soft); }
+.q-index a { display: grid; grid-template-columns: 2em minmax(0, 1fr) auto; align-items: baseline; gap: 2px 12px;
+             padding: 7px 6px 7px 0; color: var(--ink); text-decoration: none; font-size: var(--text-sm); line-height: 1.32; }
+.q-index a:hover { background: var(--index-hover); }
+.q-index a:hover .q-index-title { color: var(--accent); }
+.q-index-num { color: var(--ink-4); text-align: right; font-variant-numeric: lining-nums tabular-nums; font-size: var(--text-xs); }
+.q-index .mix { justify-self: end; }
+
+/* Question cards */
+.question h3 { margin-bottom: .7em; }
+.question:target > .question-head h3 { color: var(--accent); }
+.known > summary { flex-wrap: wrap; }
+.known > summary .mix { color: var(--ink-4); }
+
+/* The decisive questions: the open question beside what is established toward it. */
+.section.decisive > .questions { max-width: var(--wide); margin-left: auto; margin-right: auto; }
+.question.compare { --qgap: clamp(28px, 3vw, 48px); display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; }
+.question-ask, .question-known { min-width: 0; }
+.question-known { margin-top: 1.1em; padding-top: .2em; }
+.known-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 0 0 .7em; }
+.known-label { font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-4); }
+.question-known .statements { gap: 12px; }
+@media (min-width: 1080px) {
+  .question.compare { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); column-gap: var(--qgap); }
+  .question.compare > .question-head { grid-column: 1 / -1; max-width: 46rem; }
+  .question.compare.no-known > .question-ask { grid-column: 1 / -1; max-width: var(--measure); }
+  .question-known { margin-top: 0; padding-left: calc(var(--qgap) / 2); margin-left: calc(var(--qgap) / -2);
+                    border-left: 1px solid var(--rule-soft); }
+  .question-known .statement { font-size: calc(var(--text-base) * .96); }
+}
+
+/* Statements by column in a row: column, then status and its scope. */
+.cell-lines { gap: 8px; padding: 12px 0; }
+.cell-col { line-height: 1.35; }
+
+/* Narrow screens */
+@media (max-width: 560px) {
+  .statement, .principal .statement { padding: 14px 14px 12px 16px; }
+  .q-index a { grid-template-columns: 1.6em minmax(0, 1fr); }
+  .q-index .mix { grid-column: 2; justify-self: start; }
+  .question h3 { font-size: calc(var(--text-base) * 1.2); }
+  .row-count { flex-wrap: wrap; gap: 2px 10px; }
+  .math-display math { font-size: .97em; }
+}
+
+/* Print: every part open, formulas unclipped, no screen surfaces. */
+@media print {
+  @page { margin: 16mm 15mm 18mm; }
+  :root { --text-base: 10.5pt; --gutter: 0; --scroll-cue: transparent; }
+  body { --surface: transparent; }
+  .section { padding-top: 20pt; }
+  .statement { background: none !important; border-color: #bbb; box-shadow: none !important; }
+  .status-chip { background: none; padding: 0; }
+  .math-display, .math-long { overflow: visible !important; background: none !important; max-width: none; }
+  .question-head, .q-index li, .known-head { break-inside: avoid; break-after: avoid; }
+  .q-index a:hover { background: none; }
+  .question-known { border: 0; padding: 0; margin: 1em 0 0; }
+  .question.compare { display: block; }
+}
+@media print { details.known::details-content, details.row::details-content, details.col-defs::details-content { content-visibility: visible; } }
+@media print { .col-defs > dl { display: grid !important; } }
